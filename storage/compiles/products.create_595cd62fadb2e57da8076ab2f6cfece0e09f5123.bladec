<?php $_shouldextend[1]=1; ?>
<?php $this->startSection('title'); ?>
 Trang tạo mới sản phẩm
<?php $this->stopSection(); ?>
<?php $this->startSection('content'); ?>
<div class="card">
 <form action="<?php echo \htmlentities(route('admin/product/store')??'', ENT_QUOTES, 'UTF-8', false); ?>" method="post" enctype="multipart/form-data">
 <div class="mb-3">
 <label for="form-control">Tên sản phẩm</label>
 <input type="text" name="name" class="form-control" placeholder="Mời bạn nhập tên sản phẩm...">
 </div>
 <div class="mb-3">
 <label for="" class="form-label">Tên danh mục</label>
 <select name="category_id" id="" class="form-select">
 <?php $__currentLoopData = $categories; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $category): $loop = $this->incrementLoopIndices();  ?>
 <option value="<?php echo \htmlentities($category['id']??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php echo \htmlentities($category['name']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </option>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </select>
 </div>
 <div class="mb-3">
 <label for="form-control">Giá sản phẩm</label>
 <input type="number" name="price" class="form-control" placeholder="Mời bạn nhập giá sản phẩm...">
 </div>
 <div class="mb-3">
 <label for="form-control">Ngày nhập sản phẩm</label>
 <input type="date" name="date_entry" class="form-control" >
 </div>
 <div class="mb-3">
 <label for="form-control">Trạng thái sản phẩm</label>
 <select name="status" class="form-select">
 <option value="1">Còn hàng</option>
 <option value="0">Hết hàng</option>
 </select>
 </div>
 <div class="mb-3">
 <label for="" class="form-label"> hình ảnh</label>
 <input type="file" name="image_cover" class="form-control" id="" width="100px">
 </div>
 <div class="mb-3">
 <a href="<?php echo \htmlentities(route('admin/products')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-secondary"> Quay lại</a>
 <button type="submit" class="btn btn-sm btn-success">Lưu</button>
 </div>
 </form>
</div>
<?php $this->stopSection(); ?>

