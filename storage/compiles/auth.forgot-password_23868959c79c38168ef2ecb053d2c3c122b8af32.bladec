<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', 'Quên mật khẩu'); ?>

<?php $this->startSection('content'); ?>
<div class="container mt-5">
 <div class="row justify-content-center">
 <div class="col-md-6">
 <div class="card">
 <div class="card-header bg-info text-white">
 <h5 class="mb-0">Quên mật khẩu</h5>
 </div>
 <div class="card-body">
 <?php if(isset($_SESSION['error'])): ?>
 <div class="alert alert-danger"><?php echo \htmlentities($_SESSION['error']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php unset($_SESSION['error']);  ?>
 <?php endif; ?>
 <?php if(isset($_SESSION['success'])): ?>
 <div class="alert alert-success">
 <?php echo \htmlentities($_SESSION['success']??'', ENT_QUOTES, 'UTF-8', false); ?>

 <hr>
 <a href="<?php echo \htmlentities(route('reset-password')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-success btn-sm">Bấm vào đây để đặt lại mật khẩu (Link Mô phỏng)</a>
 </div>
 <?php unset($_SESSION['success']);  ?>
 <?php endif; ?>

 <form action="<?php echo \htmlentities(route('forgot-password')??'', ENT_QUOTES, 'UTF-8', false); ?>" method="POST">
 <div class="mb-3">
 <label>Nhập email của bạn:</label>
 <input type="email" name="email" class="form-control" required>
 </div>
 <button type="submit" class="btn btn-primary w-100">Gửi yêu cầu</button>
 </form>

 <div class="mt-3 text-center">
 <a href="<?php echo \htmlentities(route('login')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="text-decoration-none">Đã nhớ mật khẩu? Đăng nhập</a>
 </div>
 </div>
 </div>
 </div>
 </div>
</div>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layouts.admin'); } ?>