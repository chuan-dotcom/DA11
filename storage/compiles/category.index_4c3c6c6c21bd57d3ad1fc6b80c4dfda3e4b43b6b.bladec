<?php $_shouldextend[1]=1; ?>
<?php $this->startSection('title'); ?>
 Trang danh sách danh mục
<?php $this->stopSection(); ?>
<?php $this->startSection('content'); ?>
 <a href="<?php echo \htmlentities(route('admin/category/create')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-success">+Thêm danh mục</a>
 <table class="table">
 <thead>
 <tr>
 <td>ID</td>
 <td>TÊN DANH MỤC</td>
 <td>HÀNH ĐỘNG</td>
 </tr>
 </thead>
 <tbody>
 <?php $__currentLoopData = $categories; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $index=>$category): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td><?php echo \htmlentities($index+1??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($category['name']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <a href="<?php echo \htmlentities(route('admin/category/show/' . $category['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-primary">Xem</a>
 <a href="<?php echo \htmlentities(route('admin/category/edit/'.$category['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-warning">Sửa</a>
 <form action="<?php echo \htmlentities(route('admin/category/destroy/' . $category['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" method="post" enctype="multipart/form-data"
 onsubmit="return confirm('Bạn có chắc chắn muốn xóa?')" class="d-inline">
 <button class="btn btn-danger">Xóa</button>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </tbody>
 </table>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layouts.admin'); } ?>