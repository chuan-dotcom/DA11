<?php $_shouldextend[1]=1; ?>
<?php $this->startSection('title'); ?>
 Trang dánh sách sản phẩm
<?php $this->stopSection(); ?>
<?php $this->startSection('content'); ?>
 <a href="<?php echo \htmlentities(route('admin/product/create')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-success">+Thêm sản phẩm</a>
 <table class="table">
 <thead>
 <tr>
 <th>STT</th>
 <th>ẢNH</th>
 <th>TÊN</th>
 <th>GIÁ</th>
 <th>DANH MỤC</th>
 <th>NGÀY NHẬP</th>
 <th>TRẠNG THÁI</th>
 <th>HÀNH ĐỘNG</th>
 </tr>
 </thead>
 <tbody>
 <?php $__currentLoopData = $products; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $index=> $product): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td><?php echo \htmlentities($index+1??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <img src="<?php echo \htmlentities(file_url($product['image_cover'])??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="Hình ảnh sản phẩm" width="100px">
 </td>
 <td><?php echo \htmlentities($product['name']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities(number_format($product['price'])??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($product['category_name']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($product['date_entry']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($product['status'] == 1 ? 'Còn hàng' : 'Hết hàng'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <a href="<?php echo \htmlentities(route('admin/product/show/' . $product['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-primary">Xem</a>
 <a href="<?php echo \htmlentities(route('admin/product/edit/' . $product['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-warning">Sửa</a>
 <form action="<?php echo \htmlentities(route('admin/product/destroy/' . $product['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" method="post" enctype="multipart/form-data"
 onsubmit="return confirm('Bạn có chắc chắn muốn xóa?')" class="d-inline">
 <button class="btn btn-danger">Xóa</button>
 </form>
 
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </tbody>
 </table>
 
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layouts.admin'); } ?>