<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', 'Giỏ hàng'); ?>

<?php $this->startSection('content'); ?>
<div class="container mt-4">
 <h2>Giỏ hàng của bạn</h2>
 <hr>

 <?php if(!isset($_SESSION['cart']) || empty($_SESSION['cart'])): ?>
 <div class="alert alert-info text-center">
 Giỏ hàng của bạn đang trống! <a href="<?php echo \htmlentities(route('')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="alert-link">Mua sắm ngay</a>
 </div>
 <?php else: ?>
 <table class="table table-bordered">
 <thead class="table-dark">
 <tr>
 <th>Ảnh</th>
 <th>Sản phẩm</th>
 <th>Giá</th>
 <th>Số lượng</th>
 <th>Thành tiền</th>
 <th>Thao tác</th>
 </tr>
 </thead>
 <tbody>
 <?php $total = 0;  ?>
 <?php $__currentLoopData = $_SESSION['cart']; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $item): $loop = $this->incrementLoopIndices();  ?>
 <?php 
 $subtotal = $item['price'] * $item['quantity'];
 $total += $subtotal;
 ?>
 <tr>
 <td>
 <img src="<?php echo \htmlentities(file_url($item['image_cover'])??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="<?php echo \htmlentities($item['name']??'', ENT_QUOTES, 'UTF-8', false); ?>" style="width: 80px; height: 80px; object-fit: cover;">
 </td>
 <td><?php echo \htmlentities($item['name']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities(number_format($item['price'])??'', ENT_QUOTES, 'UTF-8', false); ?> VNĐ</td>
 <td><?php echo \htmlentities($item['quantity']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td class="text-danger fw-bold"><?php echo \htmlentities(number_format($subtotal)??'', ENT_QUOTES, 'UTF-8', false); ?> VNĐ</td>
 <td>
 <a href="<?php echo \htmlentities(route('cart/remove/' . $item['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?')">
 Xóa
 </a>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </tbody>
 </table>

 <div class="card mt-4">
 <div class="card-body">
 <form action="<?php echo \htmlentities(route('checkout')??'', ENT_QUOTES, 'UTF-8', false); ?>" method="POST">
 <h5 class="mb-3">Phương thức thanh toán:</h5>
 <div class="mb-3">
 <div class="form-check">
 <input class="form-check-input" type="radio" name="payment_method" id="cod" value="cod" checked>
 <label class="form-check-label" for="cod">
 <strong>Thanh toán khi giao hàng (COD)</strong>
 </label>
 </div>
 <div class="form-check mt-2">
 <input class="form-check-input" type="radio" name="payment_method" id="momo" value="momo">
 <label class="form-check-label" for="momo">
 <strong>Thanh toán bằng Momo</strong>
 </label>
 </div>
 </div>
 
 <div class="text-end">
 <h4>Tổng tiền: <span class="text-danger"><?php echo \htmlentities(number_format($total)??'', ENT_QUOTES, 'UTF-8', false); ?> VNĐ</span></h4>
 <a href="<?php echo \htmlentities(route('')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-secondary mt-2">Tiếp tục mua sắm</a>
 <input type="hidden" name="total_amount" value="<?php echo \htmlentities($total??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <button type="submit" class="btn btn-success mt-2" onclick="return confirm('Bạn có chắc muốn thanh toán?')">
 Thanh toán ngay
 </button>
 </div>
 </form>
 </div>
 </div>
 <?php endif; ?>
</div>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layouts.admin'); } ?>