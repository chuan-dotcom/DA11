<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', 'Quản lý Tài khoản'); ?>

<?php $this->startSection('content'); ?>
<div class="container mt-4">
 <h2>Quản lý Tài khoản Người dùng</h2>
 <a href="<?php echo \htmlentities(route('admin/users/create')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-success mb-3">+ Thêm Tài khoản</a>

 <table class="table table-bordered">
 <thead class="table-dark">
 <tr>
 <th>ID</th>
 <th>Username</th>
 <th>Email</th>
 <th>Quyền</th>
 <th>Hành động</th>
 </tr>
 </thead>
 <tbody>
 <?php $__currentLoopData = $users; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $user): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td><?php echo \htmlentities($user['id']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($user['username']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($user['email']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <span class="badge <?php echo \htmlentities($user['role'] == 1 ? 'bg-danger' : 'bg-info'??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php echo \htmlentities($user['role'] == 1 ? 'Admin' : 'User'??'', ENT_QUOTES, 'UTF-8', false); ?>

 </span>
 </td>
 <td>
 <a href="<?php echo \htmlentities(route('admin/users/edit/' . $user['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-warning">Sửa</a>
 <?php if($user['id'] != $_SESSION['user']['id']): ?>
 <a href="<?php echo \htmlentities(route('admin/users/delete/' . $user['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" 
 class="btn btn-sm btn-danger" 
 onclick="return confirm('Bạn có chắc chắn xóa?')">Xóa</a>
 <?php endif; ?>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </tbody>
 </table>
</div>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layouts.admin'); } ?>