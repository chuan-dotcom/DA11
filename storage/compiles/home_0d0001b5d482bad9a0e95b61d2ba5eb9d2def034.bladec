<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', 'Trang chủ - Danh sách sản phẩm'); ?>

<?php $this->startSection('content'); ?>
<?php if(isset($_SESSION['success'])): ?>
 <div class="alert alert-success mt-3">
 <?php echo \htmlentities($_SESSION['success']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </div>
 <?php unset($_SESSION['success']);  ?>
<?php endif; ?>
<style>
 .product-card {
 max-width: 400px;
 margin: 0 auto;
 }
 .product-card img {
 height: 350px !important;
 object-fit: cover;
 }
 .product-card .card-body {
 padding: 10px;
 }
 .product-card .card-title {
 font-size: 14px;
 margin-bottom: 5px;
 }
 .product-card .card-text {
 font-size: 12px;
 margin-bottom: 3px;
 }
 .product-card .fw-bold {
 font-size: 16px;
 }
 .cart-link {
 position: fixed;
 top: 60px;
 right: 20px;
 z-index: 999;
 }
</style>

<div class="cart-link">
 <a href="<?php echo \htmlentities(route('cart')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-success">
 Giỏ hàng <span class="badge bg-light text-dark">
 <?php echo \htmlentities(isset($_SESSION['cart']) ? count($_SESSION['cart']) : 0??'', ENT_QUOTES, 'UTF-8', false); ?>

 </span>
 </a>
</div>

<div class="container mt-4">
 <h2 class="mb-4 text-center" style="font-size: 24px;">Danh sách sản phẩm</h2>
 
 <div class="row">
 <?php $__currentLoopData = $products; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $product): $loop = $this->incrementLoopIndices();  ?>
 <div class="col-md-4 mb-4 d-flex justify-content-center">
 <div class="card h-100 shadow-sm product-card">
 <img src="<?php echo \htmlentities(file_url($product['image_cover'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="card-img-top" 
 alt="<?php echo \htmlentities($product['name']??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <div class="card-body">
 <h5 class="card-title"><?php echo \htmlentities($product['name']??'', ENT_QUOTES, 'UTF-8', false); ?></h5>
 <p class="card-text text-muted small">Danh mục: <?php echo \htmlentities($product['category_name']??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 <p class="card-text text-danger fw-bold"><?php echo \htmlentities(number_format($product['price'])??'', ENT_QUOTES, 'UTF-8', false); ?> VNĐ</p>
 </div>
 <div class="card-footer p-2 d-flex justify-content-between align-items-center">
 <span class="badge <?php echo \htmlentities($product['status'] == 1 ? 'bg-success' : 'bg-secondary'??'', ENT_QUOTES, 'UTF-8', false); ?>" style="font-size: 11px;">
 <?php echo \htmlentities($product['status'] == 1 ? 'Còn hàng' : 'Hết hàng'??'', ENT_QUOTES, 'UTF-8', false); ?>

 </span>
 <form action="<?php echo \htmlentities(route('cart/add')??'', ENT_QUOTES, 'UTF-8', false); ?>" method="POST" class="m-0">
 <input type="hidden" name="product_id" value="<?php echo \htmlentities($product['id']??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <button type="submit" class="btn btn-sm btn-primary" <?php echo \htmlentities($product['status'] == 0 ? 'disabled' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>
 Thêm giỏ hàng
 </button>
 </form>
 </div>
 </div>
 </div>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </div>
</div>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layouts.admin'); } ?>