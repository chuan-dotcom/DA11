<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title'); ?>
 <?php echo \htmlentities($title??'', ENT_QUOTES, 'UTF-8', false); ?>

<?php $this->stopSection(); ?>
<?php $this->startSection('content'); ?>
<H1>Chi tiết sản phẩm</H1>
<ul>
 <li><?php echo \htmlentities($product['name']??'', ENT_QUOTES, 'UTF-8', false); ?></li>
 <li><img src="<?php echo \htmlentities(file_url($product['image_cover'])??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="Hình ảnh hiện tại" width="100"></li>
 <li><?php echo \htmlentities(number_format( $product['price'])??'', ENT_QUOTES, 'UTF-8', false); ?></li>
 <li><?php echo \htmlentities($product['category_name']??'', ENT_QUOTES, 'UTF-8', false); ?></li>
 <li><?php echo \htmlentities($product['date_entry']??'', ENT_QUOTES, 'UTF-8', false); ?></li>
 <li><?php echo \htmlentities($product['status']==1 ? 'còn hàng' : 'Hết hàng'??'', ENT_QUOTES, 'UTF-8', false); ?></li>
 
</ul>
<a href="<?php echo \htmlentities(route('products')??'', ENT_QUOTES, 'UTF-8', false); ?>">Quay lại danh sách</a>
<?php $this->stopSection(); ?>
<?php if (isset($_shouldextend[1])) { echo $this->runChild('layouts.admin'); } ?>