<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', $title); ?>

<?php $this->startSection('content'); ?>
<style>
 .diary-thumb {
 width: 80px;
 height: 60px;
 object-fit: cover;
 border-radius: 8px;
 }
 .diary-title-link {
 color: #1e293b;
 text-decoration: none;
 font-weight: 700;
 }
 .diary-title-link:hover {
 color: #0284c7;
 }
 .stat-box {
 background: linear-gradient(135deg, #00bcd4, #00acc1);
 color: white;
 border-radius: 12px;
 padding: 1.25rem 1.5rem;
 }
</style>

<div class="hdv-card mb-4">
 <div class="d-flex justify-content-between align-items-center mb-3">
 <h4 class="fw-bold text-dark mb-0"><i class="bi bi-journal-text text-info me-2"></i> <?php echo \htmlentities($title??'', ENT_QUOTES, 'UTF-8', false); ?></h4>
 <a href="<?php echo \htmlentities(route('hdv/nhat-ky-tour/create')??'', ENT_QUOTES, 'UTF-8', false); ?><?php echo \htmlentities(!empty($selectedDepartureId) ? '?departure_id=' . $selectedDepartureId : ''??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-primary rounded-pill px-4 fw-bold">
 <i class="bi bi-plus-lg me-1"></i> Viết nhật ký mới
 </a>
 </div>
 <p class="text-muted small mb-0">Chỉ hiển thị các nhật ký của các tour mà hướng dẫn viên <?php echo \htmlentities($activeHdv['Hoten'] ?? ''??'', ENT_QUOTES, 'UTF-8', false); ?> được phân công tham gia.</p>
</div>

<div class="row g-3 mb-4">
 <div class="col-md-4">
 <div class="stat-box shadow-sm">
 <div class="small opacity-75 mb-1">Tổng số nhật ký đã viết</div>
 <div class="fs-2 fw-bold"><?php echo \htmlentities($totalDiaries ?? 0??'', ENT_QUOTES, 'UTF-8', false); ?> bài</div>
 </div>
 </div>
 <div class="col-md-4">
 <div class="stat-box shadow-sm">
 <div class="small opacity-75 mb-1">Chuyến đang lọc</div>
 <div class="fs-5 fw-bold"><?php echo \htmlentities(!empty($selectedDepartureId) ? ('#' . $selectedDepartureId) : 'Tất cả chuyến'??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 </div>
 </div>
</div>

<!-- Filter by Departure -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
 <div class="card-body py-3">
 <form method="GET" action="<?php echo \htmlentities(route('hdv/nhat-ky-tour')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="row g-2 align-items-end">
 <div class="col-md-6">
 <label class="form-label small text-muted mb-1">Lọc theo chuyến công tác của bạn</label>
 <select class="form-select form-select-sm fw-semibold" name="departure_id" onchange="this.form.submit()">
 <option value="">-- Tất cả chuyến khởi hành đã tham gia --</option>
 <?php $__currentLoopData = $departures; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $d): $loop = $this->incrementLoopIndices();  ?>
 <option value="<?php echo \htmlentities($d['id']??'', ENT_QUOTES, 'UTF-8', false); ?>" <?php echo \htmlentities(!empty($selectedDepartureId) && $selectedDepartureId == $d['id'] ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>
 #<?php echo \htmlentities($d['id']??'', ENT_QUOTES, 'UTF-8', false); ?> - <?php echo \htmlentities($d['tour_name']??'', ENT_QUOTES, 'UTF-8', false); ?> (<?php echo \htmlentities(date('d/m/Y', strtotime($d['departure_date']))??'', ENT_QUOTES, 'UTF-8', false); ?>)
 </option>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </select>
 </div>
 <?php if(!empty($selectedDepartureId)): ?>
 <div class="col-md-auto">
 <a href="<?php echo \htmlentities(route('hdv/nhat-ky-tour')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-outline-secondary rounded-pill">
 <i class="bi bi-x-circle me-1"></i> Bỏ lọc
 </a>
 </div>
 <?php endif; ?>
 </form>
 </div>
</div>

<div class="hdv-card">
 <div class="table-responsive">
 <table class="table table-hdv table-hover align-middle">
 <thead>
 <tr>
 <th style="width: 50px;">ID</th>
 <th style="width: 100px;">Hình ảnh</th>
 <th>Tiêu đề nhật ký</th>
 <th>Tour / Danh mục / Đoàn</th>
 <th>Ngày nhật ký</th>
 <th>Thời tiết</th>
 <th class="text-center">Thao tác</th>
 </tr>
 </thead>
 <tbody>
 <?php if(empty($diaries)): ?>
 <tr>
 <td colspan="7" class="text-center text-muted py-5">
 <i class="bi bi-journal-x fs-1 d-block mb-2 opacity-50"></i>
 Chưa có nhật ký tour nào. Nhấn nút "Viết nhật ký mới" để tạo bài viết.
 </td>
 </tr>
 <?php else: ?>
 <?php $__currentLoopData = $diaries; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $diary): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td class="fw-bold">#<?php echo \htmlentities($diary['id']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <?php 
 $firstPhoto = null;
 if (!empty($diary['photos'])) {
 $photos = explode(',', $diary['photos']);
 $firstPhoto = $photos[0] ?? null;
 }
 ?>
 <?php if($firstPhoto): ?>
 <img src="<?php echo \htmlentities(file_url($firstPhoto)??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="" class="diary-thumb">
 <?php else: ?>
 <span class="text-muted small">Không có ảnh</span>
 <?php endif; ?>
 </td>
 <td>
 <a href="<?php echo \htmlentities(route('hdv/nhat-ky-tour/show/' . $diary['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="diary-title-link">
 <?php echo \htmlentities($diary['title']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </a>
 <?php if(!empty($diary['mood'])): ?>
 <div class="mt-1"><span class="badge bg-warning-subtle text-dark"><i class="bi bi-emoji-smile me-1"></i> <?php echo \htmlentities($diary['mood']??'', ENT_QUOTES, 'UTF-8', false); ?></span></div>
 <?php endif; ?>
 </td>
 <td>
 <div class="fw-bold small"><?php echo \htmlentities($diary['tour_name'] ?? '—'??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <div class="text-muted small">Danh mục: <?php echo \htmlentities($diary['category_name'] ?? 'Chưa phân loại'??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <div class="text-muted small">
 <?php echo \htmlentities($diary['departure_group_name'] ?: ('Chuyến #' . $diary['departure_id'])??'', ENT_QUOTES, 'UTF-8', false); ?>

 <?php if(!empty($diary['tour_departure_date'])): ?>
 - <?php echo \htmlentities(date('d/m/Y', strtotime($diary['tour_departure_date']))??'', ENT_QUOTES, 'UTF-8', false); ?>

 <?php endif; ?>
 </div>
 </td>
 <td>
 <div class="fw-semibold"><?php echo \htmlentities(!empty($diary['diary_date']) ? date('d/m/Y', strtotime($diary['diary_date'])) : '—'??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 </td>
 <td>
 <?php if(!empty($diary['weather'])): ?>
 <span class="badge bg-info-subtle text-info-emphasis"><i class="bi bi-cloud-sun me-1"></i> <?php echo \htmlentities($diary['weather']??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 <?php else: ?>
 <span class="text-muted small">—</span>
 <?php endif; ?>
 </td>
 <td class="text-center text-nowrap">
 <a href="<?php echo \htmlentities(route('hdv/nhat-ky-tour/show/' . $diary['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-info text-white rounded-pill px-2" title="Xem">
 <i class="bi bi-eye"></i>
 </a>
 <a href="<?php echo \htmlentities(route('hdv/nhat-ky-tour/edit/' . $diary['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-warning rounded-pill px-2" title="Sửa">
 <i class="bi bi-pencil"></i>
 </a>
 <a href="<?php echo \htmlentities(route('hdv/nhat-ky-tour/delete/' . $diary['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>"
 class="btn btn-sm btn-danger rounded-pill px-2"
 title="Xóa"
 onclick="return confirm('Bạn có chắc muốn xóa nhật ký này?')">
 <i class="bi bi-trash"></i>
 </a>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php endif; ?>
 </tbody>
 </table>
 </div>
</div>

<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layouts.hdv'); } ?>