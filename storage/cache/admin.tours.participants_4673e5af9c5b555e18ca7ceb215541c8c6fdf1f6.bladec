 <?php echo \htmlentities(date('d/m/Y', strtotime($booking['booking_date']))??'', ENT_QUOTES, 'UTF-8', false); ?>

 </td>
 <td class="text-center">
 <?php if($booking['status'] == 0): ?>
 <span class="badge bg-warning text-dark">
