<div class="container mt-4">
 <h2 class="mb-4"><?php echo \htmlentities($title??'', ENT_QUOTES, 'UTF-8', false); ?></h2>

 <?php if(isset($_SESSION['flash']['success'])): ?>
 <div class="alert alert-success"><?php echo \htmlentities($_SESSION['flash']['success']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php unset($_SESSION['flash']['success']);  ?>
 <?php endif; ?>
 <?php if(isset($_SESSION['flash']['error'])): ?>
 <div class="alert alert-danger"><?php echo \htmlentities($_SESSION['flash']['error']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php unset($_SESSION['flash']['error']);  ?>
 <?php endif; ?>

 <div class="row g-3 mb-4">
 <div class="col-md-4">
 <div class="stat-box">
 <div class="small opacity-75 mb-1">Tổng số nhật ký</div>
 <div class="fs-2 fw-bold"><?php echo \htmlentities($totalDiaries ?? 0??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 </div>
 </div>
 </div>

 <div class="card mb-3">
 <div class="card-body py-3">
 <form method="GET" action="<?php echo \htmlentities(route('admin/tour-diaries')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="row g-2 align-items-end">
 <div class="col-md-5">
 <label class="form-label small text-muted mb-1">Lọc theo chuyến khởi hành</label>
 <select class="form-select" name="departure_id" onchange="this.form.submit()">
 <option value="">-- Tất cả chuyến khởi hành --</option>
 <?php $__currentLoopData = $departures; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $d): $loop = $this->incrementLoopIndices();  ?>
 <option value="<?php echo \htmlentities($d['id']??'', ENT_QUOTES, 'UTF-8', false); ?>" <?php echo \htmlentities(!empty($departureId) && $departureId == $d['id'] ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>
 #<?php echo \htmlentities($d['id']??'', ENT_QUOTES, 'UTF-8', false); ?> - <?php echo \htmlentities($d['group_name'] ?: $d['tour_name']??'', ENT_QUOTES, 'UTF-8', false); ?> (<?php echo \htmlentities(!empty($d['departure_date']) ? date('d/m/Y', strtotime($d['departure_date'])) : 'chưa xếp lịch'??'', ENT_QUOTES, 'UTF-8', false); ?>)
 </option>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </select>
 </div>
 <div class="col-md-7 text-end">
 <a href="<?php echo \htmlentities(route('admin/tour-diaries/create')??'', ENT_QUOTES, 'UTF-8', false); ?><?php echo \htmlentities(!empty($departureId) ? '?departure_id=' . $departureId : ''??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-primary">
 <i class="bi bi-plus"></i> Thêm nhật ký
 </a>
 <?php if(!empty($departureId)): ?>
 <a href="<?php echo \htmlentities(route('admin/tour-diaries')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-outline-secondary">
 <i class="bi bi-x-lg"></i> Bỏ lọc
 </a>
 <?php endif; ?>
 </div>
 </form>
 </div>
 </div>

 <div class="card">
 <div class="card-body">
 <div class="table-responsive">
 <table class="table table-bordered table-hover align-middle">
 <thead class="table-dark">
 <tr>
 <th>ID</th>
 <th>Ảnh</th>
 <th>Tiêu đề</th>
 <th>Chuyến khởi hành / Tour</th>
 <th>Ngày nhật ký</th>
 <th>Thời tiết</th>
 <th>Thao tác</th>
 </tr>
 </thead>
 <tbody>
 <?php if(empty($diaries)): ?>
 <tr>
 <td colspan="7" class="text-center text-muted py-5">
 <i class="bi bi-journal-text fs-1 d-block mb-2 opacity-50"></i>
 Chưa có nhật ký nào. Hãy nhấn "Thêm nhật ký" để bắt đầu.
 </td>
 </tr>
 <?php else: ?>
 <?php $__currentLoopData = $diaries; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $diary): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td><?php echo \htmlentities($diary['id']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <?php 
 $firstPhoto = null;
 if (!empty($diary['photos'])) {
 $rawP = trim($diary['photos']);
 if (str_starts_with($rawP, '[') && str_ends_with($rawP, ']')) {
 $decoded = json_decode($rawP, true);
 if (is_array($decoded) && !empty($decoded)) {
 $firstPhoto = $decoded[0];
 }
 }
 if (!$firstPhoto) {
 $photos = explode(',', $rawP);
 $firstPhoto = trim($photos[0] ?? '', "[] \"'\t\n\r");
 }
 }
 ?>
 <?php if($firstPhoto): ?>
 <img src="<?php echo \htmlentities(file_url($firstPhoto)??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="<?php echo \htmlentities($diary['title']??'', ENT_QUOTES, 'UTF-8', false); ?>" class="diary-thumb" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1488646953014-85cb44e25828?auto=format&fit=crop&w=400&q=80';">
 <?php else: ?>
 <img src="https://images.unsplash.com/photo-1488646953014-85cb44e25828?auto=format&fit=crop&w=400&q=80" alt="Placeholder" class="diary-thumb">
 <?php endif; ?>
 </td>
 <td>
 <a href="<?php echo \htmlentities(route('admin/tour-diaries/show/' . $diary['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="diary-title-link">
 <?php echo \htmlentities($diary['title']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </a>
 <?php if(!empty($diary['mood'])): ?>
 <div class="mt-1"><span class="mood-badge"><i class="bi bi-emoji-smile"></i> <?php echo \htmlentities($diary['mood']??'', ENT_QUOTES, 'UTF-8', false); ?></span></div>
 <?php endif; ?>
 </td>
 <td>
 <div class="fw-semibold small"><?php echo \htmlentities($diary['tour_name'] ?? '—'??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <div class="text-muted small"><?php echo \htmlentities($diary['departure_group_name'] ?? 'Đoàn #' . $diary['departure_id']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 </td>
 <td>
 <div class="fw-semibold"><?php echo \htmlentities(!empty($diary['diary_date']) ? date('d/m/Y', strtotime($diary['diary_date'])) : '—'??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 </td>
 <td>
 <?php if(!empty($diary['weather'])): ?>
 <span class="weather-badge"><i class="bi bi-cloud-sun"></i> <?php echo \htmlentities($diary['weather']??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 <?php else: ?>
 <span class="text-muted small">—</span>
 <?php endif; ?>
 </td>
 <td class="text-nowrap">
 <a href="<?php echo \htmlentities(route('admin/tour-diaries/show/' . $diary['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-info text-white" title="Xem chi tiết">
 <i class="bi bi-eye"></i>
 </a>
 <a href="<?php echo \htmlentities(route('admin/tour-diaries/edit/' . $diary['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-warning" title="Sửa">
 <i class="bi bi-pencil"></i>
 </a>
 <a href="<?php echo \htmlentities(route('admin/tour-diaries/delete/' . $diary['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>"
 class="btn btn-sm btn-danger"
 title="Xóa"
 onclick="return confirm('Bạn có chắc muốn xóa nhật ký này?')">
 <i class="bi bi-trash"></i>
 </a>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php endif; ?>
 </tbody>
 </table>
 </div>
 </div>
 </div>
</div>
