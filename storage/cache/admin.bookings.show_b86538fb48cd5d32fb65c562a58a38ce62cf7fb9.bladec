<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', $title); ?>                   

<?php $this->startSection('content'); ?>
<div class="container mt-4">
 <h2 class="mb-4"><?php echo \htmlentities($title??'', ENT_QUOTES, 'UTF-8', false); ?></h2>

 <div class="card">
 <div class="card-body">
 <table class="table table-bordered">
 <tr>
 <th width="250">Mã Booking</th>
 <td><?php echo \htmlentities($booking['id']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 </tr>
 <tr>
 <th>Tour</th>
 <td>
 <div class="d-flex flex-wrap align-items-center gap-2">
 <span><?php echo \htmlentities($booking['tour_name']??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 <a href="<?php echo \htmlentities(route('admin/tours/participants/' . $booking['tour_id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-outline-primary btn-sm">
 <i class="bi bi-people me-1"></i>Xem danh sách khách tour
 </a>
 </div>
 </td>
 </tr>
 <?php if(!empty($booking['tour_location'])): ?>
 <tr>
 <th>Địa điểm tour</th>
 <td><i class="bi bi-geo-alt text-secondary me-1"></i><?php echo \htmlentities($booking['tour_location']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 </tr>
 <?php endif; ?>
 <tr>
 <th>Khách hàng</th>
 <td><?php echo \htmlentities($booking['customer_name']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 </tr>
 <?php 
 $departureStatusMap = [
 'scheduled'   => ['Lên lịch', 'bg-primary'],
 'in_progress' => ['Đang diễn ra', 'bg-warning text-dark'],
 'completed'   => ['Hoàn thành', 'bg-success'],
 'cancelled'   => ['Đã hủy', 'bg-secondary'],
 ];
 ?>
 <?php if(!empty($booking['departure_id'])): ?>
 <tr>
 <th>Chuyến khởi hành</th>
 <td>
 <div class="d-flex flex-column gap-2">
 <div class="d-inline-flex align-items-center flex-wrap gap-2">
 <i class="bi bi-calendar-week text-primary"></i>
 <span class="fw-semibold">
 <?php echo \htmlentities(!empty($booking['departure_group_name']) ? $booking['departure_group_name'] : ('Đoàn #' . (int)$booking['departure_id'])??'', ENT_QUOTES, 'UTF-8', false); ?>

 </span>
 <?php 
 $ds = !empty($booking['departure_status']) ? $departureStatusMap[$booking['departure_status']] ?? null : null;
 ?>
 <?php if($ds): ?>
 <span class="badge <?php echo \htmlentities($ds[1]??'', ENT_QUOTES, 'UTF-8', false); ?>"><?php echo \htmlentities($ds[0]??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 <?php endif; ?>
 </div>
 <div class="small text-muted">
 <?php if(!empty($booking['departure_date_info'])): ?>
 <i class="bi bi-calendar me-1"></i>
 Khởi hành: <?php echo \htmlentities(date('d/m/Y', strtotime($booking['departure_date_info']))??'', ENT_QUOTES, 'UTF-8', false); ?>

 <?php endif; ?>
 <?php if(!empty($booking['departure_return_date']) && (!empty($booking['departure_date_info']) && $booking['departure_return_date'] !== $booking['departure_date_info'])): ?>
 <span class="mx-2">·</span>
 Trở về: <?php echo \htmlentities(date('d/m/Y', strtotime($booking['departure_return_date']))??'', ENT_QUOTES, 'UTF-8', false); ?>

 <?php endif; ?>
 </div>
 <div class="d-flex flex-wrap gap-2">
 <a href="<?php echo \htmlentities(route('admin/departures/edit/' . (int)$booking['departure_id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-outline-primary">
 <i class="bi bi-box-arrow-up-right me-1"></i>Mở chi tiết đoàn
 </a>
 <a href="<?php echo \htmlentities(route('admin/guest-groups/show/' . (int)$booking['departure_id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-outline-dark">
 <i class="bi bi-people me-1"></i>Danh sách khách đoàn
 </a>
 <a href="<?php echo \htmlentities(route('admin/bookings/unassign-departure/' . (int)$booking['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>"
 class="btn btn-sm btn-outline-warning"
 onclick="return confirm('Gỡ Booking này ra khỏi chuyến khởi hành hiện tại?')">
 <i class="bi bi-x-circle me-1"></i>Gỡ khỏi đoàn
 </a>
 </div>
 </div>
 </td>
 </tr>
 <?php else: ?>
 <tr>
 <th>Chuyến khởi hành</th>
 <td>
 <div class="d-flex flex-wrap align-items-center gap-2">
 <span class="text-muted">Chưa gắn vào đoàn nào.</span>
 <a href="<?php echo \htmlentities(route('admin/guest-groups/show/' . (int)$booking['tour_id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-outline-success">
 <i class="bi bi-link-45deg me-1"></i>Gắn vào đoàn cùng tour
 </a>
 </div>
 </td>
 </tr>
 <?php endif; ?>
 <tr>
 <th>Email</th>
 <td><?php echo \htmlentities($booking['customer_email']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 </tr>
 <tr>
 <th>Số điện thoại</th>
 <td><?php echo \htmlentities($booking['customer_phone']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 </tr>
 <?php 
 $pickup = !empty($booking['pickup_address']) ? $booking['pickup_address'] : (!empty($booking['departure_meeting_point']) ? $booking['departure_meeting_point'] : null);
 ?>
 <?php if(!empty($pickup)): ?>
 <tr>
 <th>Địa chỉ đón khách hàng</th>
 <td>
 <i class="bi bi-geo text-primary me-1"></i><?php echo \htmlentities($pickup??'', ENT_QUOTES, 'UTF-8', false); ?>

 <?php if(!empty($booking['pickup_address']) && !empty($booking['departure_meeting_point']) && $booking['pickup_address'] !== $booking['departure_meeting_point']): ?>
 <div class="mt-1"><small class="text-muted">Điểm tập kết đoàn: <?php echo \htmlentities($booking['departure_meeting_point']??'', ENT_QUOTES, 'UTF-8', false); ?></small></div>
 <?php endif; ?>
 </td>
 </tr>
 <?php endif; ?>
 <tr>
 <th>Số người</th>
 <td><?php echo \htmlentities($booking['num_people']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 </tr>
 <tr>
 <th>Ngày khởi hành</th>
 <td><?php echo \htmlentities($booking['booking_date']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 </tr>
 <?php 
 $endDate = null;
 $start = !empty($booking['booking_date']) ? $booking['booking_date'] : null;
 $duration = !empty($booking['tour_duration']) ? (int)$booking['tour_duration'] : 0;
 if ($start && $duration > 0) {
 $ts = strtotime($start);
 if ($ts !== false) {
 $endTs = strtotime('+' . ($duration - 1) . ' days', $ts);
 $endDate = date('d/m/Y', $endTs);
 }
 }
 ?>
 <tr>
 <th>Ngày kết thúc</th>
 <td>
 <?php if($endDate): ?>
 <i class="bi bi-calendar-check text-success me-1"></i>
 <strong><?php echo \htmlentities($endDate??'', ENT_QUOTES, 'UTF-8', false); ?></strong>
 <small class="text-muted ms-2">
 (<?php echo \htmlentities($duration??'', ENT_QUOTES, 'UTF-8', false); ?> ngày <?php echo \htmlentities($duration >= 2 ? ($duration - 1) . ' đêm' : '1 ngày'??'', ENT_QUOTES, 'UTF-8', false); ?>

 <?php if(!empty($booking['tour_duration'])): ?> · theo thời lượng tour <?php endif; ?>)
 </small>
 <?php else: ?>
 <span class="text-muted">Chưa xác định</span>
 <?php endif; ?>
 </td>
 </tr>
 <tr>
 <th>Tổng tiền</th>
 <td><strong class="text-danger"><?php echo \htmlentities(number_format($booking['total_price'])??'', ENT_QUOTES, 'UTF-8', false); ?> VNĐ</strong></td>
 </tr>
 <tr>
 <th>Trạng thái</th>
 <td>
 <?php 
 switch ($booking['status']) {
 case 0:
 echo '<span class="badge bg-warning text-dark">Chờ xác nhận</span>';
 break;
 case 1:
 echo '<span class="badge bg-success">Đã xác nhận</span>';
 break;
 case 2:
 echo '<span class="badge bg-danger">Đã hủy</span>';
 break;
 }
 ?>
 </td>
 </tr>
 <?php if(!empty($booking['departure_meeting_point']) && empty($booking['pickup_address'])): ?>
 <tr>
 <th>Điểm tập kết (đoàn)</th>
 <td><?php echo \htmlentities($booking['departure_meeting_point']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 </tr>
 <?php endif; ?>
 <tr>
 <th>Ghi chú</th>
 <td><?php echo !empty($booking['note']) ? nl2br(e($booking['note'])) : 'Không có ghi chú'; ?></td>
 </tr>
 <tr>
 <th>Ngày tạo</th>
 <td><?php echo \htmlentities($booking['created_at']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 </tr>
 </table>

 <a href="<?php echo \htmlentities(route('admin/bookings/edit/' . $booking['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-warning">Sửa</a>
 <a href="<?php echo \htmlentities(route('admin/bookings')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-secondary">Quay lại</a>
 </div>
 </div>
</div>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layouts.admin'); } ?>