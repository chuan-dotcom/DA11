 <img src="<?php echo \htmlentities(file_url($img)??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="Ảnh <?php echo \htmlentities($idx + 1??'', ENT_QUOTES, 'UTF-8', false); ?>" loading="lazy">
