<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', $title); ?>

<?php $this->startSection('content'); ?>
<div class="container mt-4">              
 <h2 class="mb-4"><?php echo \htmlentities($title??'', ENT_QUOTES, 'UTF-8', false); ?></h2>

 <?php if(isset($_SESSION['error'])): ?>
 <div class="alert alert-danger"><?php echo \htmlentities($_SESSION['error']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php unset($_SESSION['error']);  ?>
 <?php endif; ?>

 <div class="card">
 <div class="card-body">
 <form action="<?php echo \htmlentities(route('admin/tours/update/' . $tour['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" method="POST" enctype="multipart/form-data">
 <div class="row">
 <div class="col-md-8">
 <div class="mb-3">
 <label for="name" class="form-label">Tên tour <span class="text-danger">*</span></label>
 <input type="text" class="form-control" id="name" name="name" value="<?php echo \htmlentities($tour['name']??'', ENT_QUOTES, 'UTF-8', false); ?>" required>
 </div>
 <div class="mb-3">
 <label for="category_id" class="form-label">Danh mục tour <span class="text-danger">*</span></label>
 <select class="form-select" id="category_id" name="category_id" required>
 <option value="">-- Chọn danh mục --</option>
 <?php $__currentLoopData = $categories; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $category): $loop = $this->incrementLoopIndices();  ?>
 <option value="<?php echo \htmlentities($category['id']??'', ENT_QUOTES, 'UTF-8', false); ?>" <?php echo \htmlentities($tour['category_id'] == $category['id'] ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>
 <?php echo \htmlentities($category['name']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </option>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </select>
 </div>
 <div class="mb-3">
 <label for="price" class="form-label">Giá (VNĐ) <span class="text-danger">*</span></label>
 <input type="number" class="form-control" id="price" name="price" value="<?php echo \htmlentities($tour['price']??'', ENT_QUOTES, 'UTF-8', false); ?>" required>
 </div>
 <div class="mb-3">
 <label for="duration" class="form-label">Thời gian <span class="text-danger">*</span></label>
 <input type="text" class="form-control" id="duration" name="duration" value="<?php echo \htmlentities($tour['duration']??'', ENT_QUOTES, 'UTF-8', false); ?>" placeholder="Ví dụ: 3 ngày 2 đêm" required>
 </div>
 <div class="mb-3">
 <label for="location" class="form-label">Địa điểm tour</label>
 <input type="text" class="form-control" id="location" name="location" value="<?php echo \htmlentities($tour['location'] ?? ''??'', ENT_QUOTES, 'UTF-8', false); ?>" placeholder="Ví dụ: Sapa, Ninh Bình, Đà Lạt">
 </div>
 </div>
 <div class="col-md-4">
 <?php if($tour['image']): ?>
 <div class="mb-3">
 <img src="<?php echo \htmlentities(file_url($tour['image'])??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="<?php echo \htmlentities($tour['name']??'', ENT_QUOTES, 'UTF-8', false); ?>" style="width: 100%; height: 200px; object-fit: cover;">
 </div>
 <?php endif; ?>
 <div class="mb-3">
 <label for="image" class="form-label">Ảnh tour</label>
 <input type="file" class="form-control" id="image" name="image" accept="image/*">
 </div>
 <div class="mb-3">
 <label for="status" class="form-label">Trạng thái</label>
 <select class="form-select" id="status" name="status">
 <option value="1" <?php echo \htmlentities($tour['status'] == 1 ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Hiển thị</option>
 <option value="0" <?php echo \htmlentities($tour['status'] == 0 ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Ẩn</option>
 </select>
 </div>
 </div>
 </div>
 <div class="mb-3">
 <label for="description" class="form-label">Mô tả</label>
 <textarea class="form-control" id="description" name="description" rows="6"><?php echo \htmlentities($tour['description']??'', ENT_QUOTES, 'UTF-8', false); ?></textarea>
 </div>
 <button type="submit" class="btn btn-primary">
 <i class="bi bi-save"></i> Cập nhật
 </button>
 <a href="<?php echo \htmlentities(route('admin/tours')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-secondary">
 <i class="bi bi-arrow-left"></i> Quay lại
 </a>
 </form>
 </div>
 </div>
</div>
<?php $this->stopSection(); ?>
<?php if (isset($_shouldextend[1])) { echo $this->runChild('layouts.admin'); } ?>