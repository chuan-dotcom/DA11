 <th>Ngày đặt</th>
 <th>Trạng thái</th>
 <th width="320">Thao tác</th>
 </tr>
 </thead>
 <tbody>
 <?php if(empty($bookings)): ?>
 <tr>
 <td colspan="12" class="text-center">Chưa có dữ liệu</td>
 </tr>
 <?php else: ?>
 <?php $__currentLoopData = $bookings; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $booking): $loop = $this->incrementLoopIndices();  ?>
 <?php 
 $pickup = !empty($booking['pickup_address']) ? $booking['pickup_address'] : (!empty($booking['departure_meeting_point']) ? $booking['departure_meeting_point'] : null);
 ?>
 <tr>
 <td><?php echo \htmlentities($booking['id']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($booking['tour_name']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <?php if(!empty($booking['tour_location'])): ?>
 <span class="badge bg-secondary">
 <i class="bi bi-geo-alt me-1"></i><?php echo \htmlentities($booking['tour_location']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </span>
 <?php else: ?>
 <span class="text-muted small">—</span>
 <?php endif; ?>
 </td>
 <td><?php echo \htmlentities($booking['customer_name']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($booking['customer_email']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($booking['customer_phone']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <?php if(!empty($pickup)): ?>
 <span class="d-inline-flex align-items-center gap-1">
 <i class="bi bi-geo text-primary"></i>
