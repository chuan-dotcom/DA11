<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', $title); ?>

<?php $this->startSection('content'); ?>                
<div class="container mt-4">
 <h2 class="mb-4"><?php echo \htmlentities($title??'', ENT_QUOTES, 'UTF-8', false); ?></h2>

 <?php if(isset($_SESSION['flash']['success'])): ?>
 <div class="alert alert-success"><?php echo \htmlentities($_SESSION['flash']['success']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php unset($_SESSION['flash']['success']);  ?>
 <?php endif; ?>
 <?php if(isset($_SESSION['flash']['error'])): ?>
 <div class="alert alert-danger"><?php echo \htmlentities($_SESSION['flash']['error']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php unset($_SESSION['flash']['error']);  ?>
 <?php endif; ?>
 <?php if(isset($_SESSION['success'])): ?>
 <div class="alert alert-success"><?php echo \htmlentities($_SESSION['success']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php unset($_SESSION['success']);  ?>
 <?php endif; ?>

 <div class="mb-3">
 <a href="<?php echo \htmlentities(route('admin/bookings/create')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-primary">
 <i class="bi bi-plus-circle"></i> Thêm Booking
 </a>
 </div>

 <div class="card">
 <div class="card-body">
 <div class="table-responsive">
 <table class="table table-bordered table-hover align-middle">
 <thead class="table-dark">
 <tr>
 <th>ID</th>
 <th>Tour</th>
 <th>Địa chỉ tour</th>
 <th>Khách hàng</th>
 <th>Email</th>
 <th>SĐT</th>
 <th>Địa chỉ đón</th>
 <th>Số người</th>
 <th>Tổng tiền</th>
 <th>Ngày đặt</th>
 <th>Trạng thái</th>
 <th width="320">Thao tác</th>
 </tr>
 </thead>
 <tbody>
 <?php if(empty($bookings)): ?>
 <tr>
 <td colspan="12" class="text-center">Chưa có dữ liệu</td>
 </tr>
 <?php else: ?>
 <?php $__currentLoopData = $bookings; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $booking): $loop = $this->incrementLoopIndices();  ?>
 <?php 
 $pickup = !empty($booking['pickup_address']) ? $booking['pickup_address'] : (!empty($booking['departure_meeting_point']) ? $booking['departure_meeting_point'] : null);
 ?>
 <tr>
 <td><?php echo \htmlentities($booking['id']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($booking['tour_name']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <?php if(!empty($booking['tour_location'])): ?>
 <span class="badge bg-secondary">
 <i class="bi bi-geo-alt me-1"></i><?php echo \htmlentities($booking['tour_location']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </span>
 <?php else: ?>
 <span class="text-muted small">—</span>
 <?php endif; ?>
 </td>
 <td><?php echo \htmlentities($booking['customer_name']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($booking['customer_email']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($booking['customer_phone']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <?php if(!empty($pickup)): ?>
 <span class="d-inline-flex align-items-center gap-1">
 <i class="bi bi-geo text-primary"></i>
 <span style="max-width:200px;display:inline-block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="<?php echo \htmlentities(htmlentities($pickup)??'', ENT_QUOTES, 'UTF-8', false); ?>"><?php echo \htmlentities($pickup??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 </span>
 <?php if(!empty($booking['pickup_address']) && !empty($booking['departure_meeting_point']) && $booking['pickup_address'] !== $booking['departure_meeting_point']): ?>
 <div><small class="text-muted">Điểm tập kết: <?php echo \htmlentities($booking['departure_meeting_point']??'', ENT_QUOTES, 'UTF-8', false); ?></small></div>
 <?php endif; ?>
 <?php else: ?>
 <span class="text-muted small">—</span>
 <?php endif; ?>
 </td>
 <td><?php echo \htmlentities($booking['num_people']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td class="text-danger"><?php echo \htmlentities(number_format($booking['total_price'])??'', ENT_QUOTES, 'UTF-8', false); ?> VNĐ</td>
 <td><?php echo \htmlentities($booking['booking_date']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <?php if($booking['status'] == 0): ?>
 <span class="badge bg-warning text-dark">Chờ xác nhận</span>
 <?php elseif($booking['status'] == 1): ?>
 <span class="badge bg-success">Đã xác nhận</span>
 <?php else: ?>
 <span class="badge bg-danger">Đã hủy</span>
 <?php endif; ?>
 </td>
 <td class="text-nowrap">
 <a href="<?php echo \htmlentities(route('admin/tours/participants/' . $booking['tour_id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-outline-primary btn-sm" title="Xem danh sách khách của tour này">
 <i class="bi bi-people"></i> Khách tour
 </a>
 <a href="<?php echo \htmlentities(route('admin/bookings/show/' . $booking['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-info btn-sm">Chi tiết</a>
 <a href="<?php echo \htmlentities(route('admin/bookings/edit/' . $booking['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-warning btn-sm">Sửa</a>
 <a href="<?php echo \htmlentities(route('admin/bookings/delete/' . $booking['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc muốn xóa?')">Xóa</a>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php endif; ?>
 </tbody>
 </table>
 </div>
 </div>
 </div>
</div>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layouts.admin'); } ?>