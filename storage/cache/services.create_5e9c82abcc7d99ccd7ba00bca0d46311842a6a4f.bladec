 <select name="tour_id" class="form-select" required>
 <option value="">-- Chọn Tour --</option>
 <?php $__currentLoopData = $tours; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $tour): $loop = $this->incrementLoopIndices();  ?>
 <option value="<?php echo \htmlentities($tour['id']??'', ENT_QUOTES, 'UTF-8', false); ?>" <?php echo \htmlentities((isset($_POST['tour_id']) && $_POST['tour_id'] == $tour['id']) ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>
 #<?php echo \htmlentities($tour['id']??'', ENT_QUOTES, 'UTF-8', false); ?> - <?php echo \htmlentities($tour['name']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </option>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </select>
 </div>

