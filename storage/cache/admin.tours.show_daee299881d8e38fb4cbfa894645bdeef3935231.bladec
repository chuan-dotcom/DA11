 <i class="bi bi-arrow-left"></i> Quay lại danh sách
 </a>
 </div>

 <div class="tour-detail-card">
 <div class="row g-0">
 <div class="col-md-6">
 <?php if(!empty($tour['image'])): ?>
 <img src="<?php echo \htmlentities(file_url($tour['image'])??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="<?php echo \htmlentities($tour['name']??'', ENT_QUOTES, 'UTF-8', false); ?>" class="tour-detail-image">
 <?php else: ?>
 <div class="tour-detail-image-empty">
 <span><i class="bi bi-image" style="font-size:2rem;"></i><br>Không có ảnh</span>
 </div>
 <?php endif; ?>
 </div>

 <div class="col-md-6 p-4">
 <h3 class="fw-bold mb-2"><?php echo \htmlentities($tour['name']??'', ENT_QUOTES, 'UTF-8', false); ?></h3>
 <div class="tour-price mb-3"><?php echo \htmlentities(number_format($tour['price'])??'', ENT_QUOTES, 'UTF-8', false); ?> VNĐ</div>

 <div class="row">
 <div class="col-6">
 <div class="info-label">Danh mục</div>
 <div class="info-value">
 <i class="bi bi-tag"></i>
 <?php echo \htmlentities($tour['category_name'] ?? 'Chưa phân loại'??'', ENT_QUOTES, 'UTF-8', false); ?>

 </div>
 </div>
 <div class="col-6">
 <div class="info-label">Thời gian</div>
 <div class="info-value">
 <i class="bi bi-clock"></i>
 <?php echo \htmlentities($tour['duration'] ?: 'Chưa cập nhật'??'', ENT_QUOTES, 'UTF-8', false); ?>

 </div>
 </div>
 <div class="col-6">
 <div class="info-label">Địa điểm</div>
 <div class="info-value">
 <i class="bi bi-geo-alt"></i>
 <?php echo \htmlentities(!empty($tour['location']) ? $tour['location'] : 'Chưa cập nhật'??'', ENT_QUOTES, 'UTF-8', false); ?>

 </div>
 </div>
 <div class="col-6">
 <div class="info-label">Số khách tối đa</div>
 <div class="info-value">
 <i class="bi bi-people-fill"></i>
 <?php if(!empty($tour['max_participants'])): ?>
 <?php echo \htmlentities(number_format($tour['max_participants'])??'', ENT_QUOTES, 'UTF-8', false); ?> người
 <?php else: ?>
 <span class="text-muted">Không giới hạn</span>
 <?php endif; ?>
 </div>
 </div>
 <div class="col-6">
 <div class="info-label">Trạng thái</div>
 <div class="info-value">
 <?php if($tour['status'] == 1): ?>
 <span class="badge bg-success">Hiển thị</span>
 <?php else: ?>
 <span class="badge bg-secondary">Ẩn</span>
 <?php endif; ?>
 </div>
 </div>
 <div class="col-6">
 <div class="info-label">Mã tour</div>
 <div class="info-value">#<?php echo \htmlentities($tour['id']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 </div>
 </div>

 <?php 
 $confirmed = (int)($stats['confirmed_people'] ?? 0);
 $pending = (int)($stats['pending_people'] ?? 0);
 $total = $confirmed + $pending;
 $max = (int)($tour['max_participants'] ?? 0);
 if ($max > 0) {
 $percent = min(round(($confirmed / $max) * 100), 100);
 $remaining = max($max - $confirmed, 0);
 if ($percent >= 90) {
 $barClass = 'bg-danger';
 $badgeClass = 'bg-danger';
 } elseif ($percent >= 70) {
 $barClass = 'bg-warning';
 $badgeClass = 'bg-warning text-dark';
 } else {
 $barClass = 'bg-success';
 $badgeClass = 'bg-success';
 }
 }
 ?>
 <?php if($max > 0 || $total > 0): ?>
 <div class="mt-3 p-3 rounded" style="background:#f8fafc;border:1px solid #e5e7eb;">
 <div class="d-flex justify-content-between align-items-center mb-2">
 <div class="fw-semibold text-dark">
 <i class="bi bi-person-check"></i> Tình hình đặt chỗ
 </div>
 <div>
 <?php if($max > 0): ?>
 <span class="badge <?php echo \htmlentities($badgeClass??'', ENT_QUOTES, 'UTF-8', false); ?>">
 Còn <?php echo \htmlentities($remaining??'', ENT_QUOTES, 'UTF-8', false); ?> / <?php echo \htmlentities($max??'', ENT_QUOTES, 'UTF-8', false); ?> chỗ
 </span>
 <?php else: ?>
 <span class="badge bg-info">Không giới hạn</span>
 <?php endif; ?>
 </div>
 </div>
 <div class="row g-2 mb-2">
 <div class="col-auto">
 <span class="badge bg-success-subtle text-success border border-success-subtle">
 <i class="bi bi-check-circle-fill"></i> Đã xác nhận: <b><?php echo \htmlentities($confirmed??'', ENT_QUOTES, 'UTF-8', false); ?></b>
 </span>
 </div>
 <div class="col-auto">
 <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
 <i class="bi bi-hourglass-split"></i> Chờ xác nhận: <b><?php echo \htmlentities($pending??'', ENT_QUOTES, 'UTF-8', false); ?></b>
 </span>
 </div>
 <div class="col-auto ms-auto">
 <span class="text-muted small">Tổng đăng ký: <b class="text-dark"><?php echo \htmlentities($total??'', ENT_QUOTES, 'UTF-8', false); ?></b></span>
 </div>
 </div>
 <?php if($max > 0): ?>
 <div class="progress" style="height:10px;border-radius:999px;">
 <div class="progress-bar <?php echo \htmlentities($barClass??'', ENT_QUOTES, 'UTF-8', false); ?> progress-bar-striped" 
 role="progressbar" 
 style="width:<?php echo \htmlentities($percent??'', ENT_QUOTES, 'UTF-8', false); ?>%;border-radius:999px;"
 aria-valuenow="<?php echo \htmlentities($percent??'', ENT_QUOTES, 'UTF-8', false); ?>" 
 aria-valuemin="0" 
 aria-valuemax="100">
 </div>
 </div>
 <div class="mt-1 small text-muted text-end"><?php echo \htmlentities($percent??'', ENT_QUOTES, 'UTF-8', false); ?>% chỗ đã được xác nhận</div>
 <?php endif; ?>
 </div>
 <?php endif; ?>

 <hr>

 <h5 class="fw-bold mb-2">
 <i class="bi bi-info-circle"></i> Mô tả / Giới thiệu tour
 </h5>
 <div class="desc-box">
 <?php if(!empty(trim($tour['description'] ?? ''))): ?>
 <?php echo \htmlentities($tour['description']??'', ENT_QUOTES, 'UTF-8', false); ?>

 <?php else: ?>
 <span class="text-muted">Tour này chưa có mô tả giới thiệu.</span>
 <?php endif; ?>
 </div>

 <?php $detailUrl = absolute_url('tour/' . $tour['id']);  ?>
 <div class="mt-4 p-3 border rounded bg-white">
 <div class="d-flex flex-wrap align-items-center gap-3">
 <div id="tour-detail-qr"></div>
 <div>
 <div class="fw-semibold mb-1">
 <i class="bi bi-qr-code"></i> Quét QR để mở trang chi tiết tour
 </div>
 <div class="small text-muted text-break"><?php echo \htmlentities($detailUrl??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 </div>
 </div>
 </div>

 <div class="mt-4 d-flex gap-2 flex-wrap">
 <a href="<?php echo \htmlentities(route('admin/tours/participants/' . $tour['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-success">
 <i class="bi bi-people"></i> Xem người tham gia
 </a>
 <a href="<?php echo \htmlentities(route('admin/tours/edit/' . $tour['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-warning">
 <i class="bi bi-pencil"></i> Sửa tour
 </a>
 <a href="<?php echo \htmlentities(route('admin/tours')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-outline-secondary">
