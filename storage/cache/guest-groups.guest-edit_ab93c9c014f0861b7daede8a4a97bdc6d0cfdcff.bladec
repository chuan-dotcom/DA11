<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', $title); ?>

<?php $this->startSection('content'); ?>
<div class="container mt-4">
 <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
 <div>
 <h2 class="mb-1"><?php echo \htmlentities($title??'', ENT_QUOTES, 'UTF-8', false); ?></h2>
 <div class="text-muted">Booking #<?php echo \htmlentities($booking['id']??'', ENT_QUOTES, 'UTF-8', false); ?> - <?php echo \htmlentities($booking['customer_name']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 </div>
 <div class="d-flex gap-2 flex-wrap">
 <a href="<?php echo \htmlentities(route('admin/guest-groups/show/' . $guestGroup['id'] . '?booking_id=' . $booking['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-outline-secondary">
 <i class="bi bi-arrow-left"></i> Quay lại
 </a>
 </div>
 </div>

 <?php if(isset($_SESSION['flash']['error'])): ?>
 <div class="alert alert-danger"><?php echo \htmlentities($_SESSION['flash']['error']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php unset($_SESSION['flash']['error']);  ?>
 <?php endif; ?>

 <div class="card">
 <div class="card-body">
 <form action="<?php echo \htmlentities(route('admin/guest-groups/booking-guests/update/' . $guestGroup['id'] . '/' . $guest['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" method="POST">
 <div class="row g-3">
 <div class="col-md-6">
 <label class="form-label">Họ tên <span class="text-danger">*</span></label>
 <input type="text" name="full_name" class="form-control" required value="<?php echo \htmlentities(isset($_POST['full_name']) ? htmlentities($_POST['full_name']) : htmlentities($guest['full_name'] ?? '')??'', ENT_QUOTES, 'UTF-8', false); ?>">
 </div>
 <div class="col-md-3">
 <label class="form-label">Giới tính</label>
 <?php 
 $genderValue = isset($_POST['gender']) ? $_POST['gender'] : ($guest['gender'] ?? '');
 ?>
 <select name="gender" class="form-select">
 <option value="" <?php echo \htmlentities($genderValue === '' ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>-- Chọn --</option>
 <option value="male" <?php echo \htmlentities($genderValue === 'male' ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Nam</option>
 <option value="female" <?php echo \htmlentities($genderValue === 'female' ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Nữ</option>
 <option value="other" <?php echo \htmlentities($genderValue === 'other' ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Khác</option>
 </select>
 </div>
 <div class="col-md-3">
 <label class="form-label">Ngày sinh</label>
 <input type="date" name="dob" class="form-control" value="<?php echo \htmlentities(isset($_POST['dob']) ? htmlentities($_POST['dob']) : htmlentities($guest['dob'] ?? '')??'', ENT_QUOTES, 'UTF-8', false); ?>">
 </div>

 <div class="col-md-4">
 <label class="form-label">SĐT</label>
 <input type="text" name="phone" class="form-control" value="<?php echo \htmlentities(isset($_POST['phone']) ? htmlentities($_POST['phone']) : htmlentities($guest['phone'] ?? '')??'', ENT_QUOTES, 'UTF-8', false); ?>">
 </div>
 <div class="col-md-4">
 <label class="form-label">Email</label>
 <input type="email" name="email" class="form-control" value="<?php echo \htmlentities(isset($_POST['email']) ? htmlentities($_POST['email']) : htmlentities($guest['email'] ?? '')??'', ENT_QUOTES, 'UTF-8', false); ?>">
 </div>
 <div class="col-md-4">
 <label class="form-label">CCCD/Passport</label>
 <input type="text" name="identity_no" class="form-control" value="<?php echo \htmlentities(isset($_POST['identity_no']) ? htmlentities($_POST['identity_no']) : htmlentities($guest['identity_no'] ?? '')??'', ENT_QUOTES, 'UTF-8', false); ?>">
 </div>

 <div class="col-md-8">
 <label class="form-label">Địa chỉ</label>
 <input type="text" name="address" class="form-control" value="<?php echo \htmlentities(isset($_POST['address']) ? htmlentities($_POST['address']) : htmlentities($guest['address'] ?? '')??'', ENT_QUOTES, 'UTF-8', false); ?>">
 </div>
 <div class="col-md-4">
 <label class="form-label">Thanh toán</label>
 <?php 
 $paymentValue = isset($_POST['payment_status']) ? $_POST['payment_status'] : ($guest['payment_status'] ?? 'unpaid');
 ?>
 <select name="payment_status" class="form-select">
 <option value="unpaid" <?php echo \htmlentities($paymentValue === 'unpaid' ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Chưa thanh toán</option>
 <option value="deposit" <?php echo \htmlentities($paymentValue === 'deposit' ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Đã đặt cọc</option>
 <option value="paid" <?php echo \htmlentities($paymentValue === 'paid' ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Đã thanh toán</option>
 </select>
 </div>

 <div class="col-12">
 <label class="form-label">Ghi chú</label>
 <textarea name="note" class="form-control" rows="3"><?php echo \htmlentities(isset($_POST['note']) ? htmlentities($_POST['note']) : htmlentities($guest['note'] ?? '')??'', ENT_QUOTES, 'UTF-8', false); ?></textarea>
 </div>
 </div>

 <div class="mt-3 d-flex gap-2">
 <button type="submit" class="btn btn-primary">
 <i class="bi bi-save"></i> Lưu
 </button>
 <a href="<?php echo \htmlentities(route('admin/guest-groups/show/' . $guestGroup['id'] . '?booking_id=' . $booking['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-secondary">
 Hủy
 </a>
 </div>
 </form>
 </div>
 </div>
</div>
<?php $this->stopSection(); ?>


