 <?php if(empty($assignedTours)): ?>
 <tr>
 <td colspan="10" class="text-center py-5 text-muted">
 Chưa có tour nào được phân công.
 </td>
 </tr>
 <?php else: ?>
 <?php $__currentLoopData = $assignedTours; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $t): $loop = $this->incrementLoopIndices();  ?>
 <tr class="<?php echo \htmlentities((int)$selectedDepartureId === (int)$t['departure_id'] ? 'table-primary' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <td class="fw-bold text-dark">#<?php echo \htmlentities($t['primary_booking_id'] ?: $t['departure_id']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <a href="<?php echo \htmlentities(route('hdv/thong-tin-tour?tab=chi-tiet&departure_id=' . $t['departure_id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="fw-bold text-primary text-decoration-none">
 <?php echo \htmlentities($t['tour_name']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </a>
 <?php if(!empty($t['group_name'])): ?>
 <div class="text-muted small">(<?php echo \htmlentities($t['group_name']??'', ENT_QUOTES, 'UTF-8', false); ?>)</div>
 <?php endif; ?>
 <div class="text-muted small mt-1">Danh mục: <?php echo \htmlentities($t['category_name'] ?: 'Chưa phân loại'??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 </td>
 <td>
 <div class="fw-bold text-dark"><?php echo \htmlentities($t['primary_customer_name'] ?: 'Khách đoàn'??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <div class="text-muted small"><?php echo \htmlentities($t['total_guests']??'', ENT_QUOTES, 'UTF-8', false); ?> người</div>
 </td>
 <td><?php echo \htmlentities($t['meeting_point'] ?: '—'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($t['meeting_time'] ?: '15:22:00'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($t['return_time'] ?? '21:29:00'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities(!empty($t['departure_date']) ? date('Y-m-d', strtotime($t['departure_date'])) : '—'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities(!empty($t['return_date']) ? date('Y-m-d', strtotime($t['return_date'])) : '—'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($t['assignment_notes'] ?: '—'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td class="text-center">
 <a href="<?php echo \htmlentities(route('hdv/tour-phan-cong?departure_id=' . $t['departure_id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-primary rounded-3 px-3 fw-bold">
 Xem chi tiết
 </a>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php endif; ?>
 </tbody>
 </table>
 </div>
</div>

<!-- Detailed Customer List Section for Selected Tour -->
<?php if($selectedTour): ?>
 <div class="hdv-card border-primary">
 <div class="d-flex justify-content-between align-items-center mb-3">
 <div>
 <h5 class="fw-bold text-primary mb-1">
 <i class="bi bi-people-fill me-2"></i> Danh sách khách hàng: <?php echo \htmlentities($selectedTour['tour_name']??'', ENT_QUOTES, 'UTF-8', false); ?> (#<?php echo \htmlentities($selectedTour['departure_id']??'', ENT_QUOTES, 'UTF-8', false); ?>)
 </h5>
 <p class="text-muted small mb-0">Ngày đi: <?php echo \htmlentities(date('d/m/Y', strtotime($selectedTour['departure_date']))??'', ENT_QUOTES, 'UTF-8', false); ?> | Khởi hành từ điểm hẹn: <?php echo \htmlentities($selectedTour['meeting_point'] ?: 'Chưa ghi chú'??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 </div>
 <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill"><?php echo \htmlentities(count($guests)??'', ENT_QUOTES, 'UTF-8', false); ?> Khách</span>
 </div>

 <div class="table-responsive">
 <table class="table table-bordered table-hover align-middle">
 <thead class="table-light">
 <tr>
 <th style="width: 50px;">STT</th>
 <th>Họ và Tên Khách Hang</th>
