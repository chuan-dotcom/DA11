<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', $title); ?>

<?php $this->startSection('content'); ?>
<div class="container mt-4">
 <h2 class="mb-4"><?php echo \htmlentities($title??'', ENT_QUOTES, 'UTF-8', false); ?></h2>

 <div class="card">
 <div class="card-body">
 <div class="row">
 <div class="col-md-6">
 <?php if($tour['image']): ?>
 <img src="<?php echo \htmlentities(file_url($tour['image'])??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="<?php echo \htmlentities($tour['name']??'', ENT_QUOTES, 'UTF-8', false); ?>" class="img-fluid rounded" style="width: 100%; height: 400px; object-fit: cover;">
 <?php else: ?>
 <div style="width: 100%; height: 400px; background-color: #f0f0f0; display: flex; align-items: center; justify-content: center;">
 <span class="text-muted">Không có ảnh</span>
 </div>
 <?php endif; ?>
 </div>
 <div class="col-md-6">
 <h3><?php echo \htmlentities($tour['name']??'', ENT_QUOTES, 'UTF-8', false); ?></h3>
 <h4 class="text-danger"><?php echo \htmlentities(number_format($tour['price'])??'', ENT_QUOTES, 'UTF-8', false); ?> VNĐ</h4>
 <p><strong>Danh mục:</strong> <?php echo \htmlentities($tour['category_name']??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 <p><strong>Thời gian:</strong> <?php echo \htmlentities($tour['duration']??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 <p><strong>Trạng thái:</strong> 
 <?php if($tour['status'] == 1): ?>
 <span class="badge bg-success">Hiển thị</span>
 <?php else: ?>
 <span class="badge bg-secondary">Ẩn</span>
 <?php endif; ?>
 </p>
 <hr>
 <h5>Mô tả</h5>
 <p><?php echo \htmlentities($tour['description']??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 </div>
 </div>
 </div>
 </div>

 <div class="mt-3">
 <a href="<?php echo \htmlentities(route('admin/tours/edit/' . $tour['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-warning">
 <i class="bi bi-pencil"></i> Sửa
 </a>
 <a href="<?php echo \htmlentities(route('admin/tours')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-secondary">
 <i class="bi bi-arrow-left"></i> Quay lại
 </a>
 </div>
</div>
<?php $this->stopSection(); ?>
<?php if (isset($_shouldextend[1])) { echo $this->runChild('layouts.admin'); } ?>