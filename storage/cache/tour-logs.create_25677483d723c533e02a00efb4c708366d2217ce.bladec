 #<?php echo \htmlentities($d['id']??'', ENT_QUOTES, 'UTF-8', false); ?> - <?php echo \htmlentities($d['tour_name'] ?? 'Tour'??'', ENT_QUOTES, 'UTF-8', false); ?>

 (<?php echo \htmlentities(date('d/m/Y', strtotime($d['departure_date']))??'', ENT_QUOTES, 'UTF-8', false); ?>)
