 <select class="form-select" id="departure_id" name="departure_id" required>
 <option value="">-- Chọn chuyến khởi hành --</option>
 <?php $__currentLoopData = $departures; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $d): $loop = $this->incrementLoopIndices();  ?>
 <option value="<?php echo \htmlentities($d['id']??'', ENT_QUOTES, 'UTF-8', false); ?>" <?php echo \htmlentities($assignment['departure_id'] == $d['id'] ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>
 <?php echo \htmlentities($d['tour_name']??'', ENT_QUOTES, 'UTF-8', false); ?> - <?php echo \htmlentities(date('d/m/Y', strtotime($d['departure_date']))??'', ENT_QUOTES, 'UTF-8', false); ?>

 </option>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </select>
 </div>
 <div class="mb-3">
 <label for="staff_id" class="form-label">Nhân viên <span class="text-danger">*</span></label>
 <select class="form-select" id="staff_id" name="staff_id" required>
 <option value="">-- Chọn nhân viên --</option>
 <?php $__currentLoopData = $staffList; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $s): $loop = $this->incrementLoopIndices();  ?>
 <option value="<?php echo \htmlentities($s['HDV_id']??'', ENT_QUOTES, 'UTF-8', false); ?>" <?php echo \htmlentities($assignment['staff_id'] == $s['HDV_id'] ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>
 <?php echo \htmlentities($s['Hoten']??'', ENT_QUOTES, 'UTF-8', false); ?> - <?php echo \htmlentities($s['Ngonngu'] ?? 'Tiếng Việt'??'', ENT_QUOTES, 'UTF-8', false); ?>

 </option>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </select>
 </div>
 <div class="mb-3">
 <label for="role" class="form-label">Vai trò <span class="text-danger">*</span></label>
 <select class="form-select" id="role" name="role" required>
 <option value="lead_guide" <?php echo \htmlentities($assignment['role'] == 'lead_guide' ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>HDV chính</option>
 <option value="assistant_guide" <?php echo \htmlentities($assignment['role'] == 'assistant_guide' ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>HDV phụ</option>
 <option value="driver" <?php echo \htmlentities($assignment['role'] == 'driver' ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Lái xe</option>
 <option value="photographer" <?php echo \htmlentities($assignment['role'] == 'photographer' ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Nhiếp ảnh</option>
 <option value="other" <?php echo \htmlentities($assignment['role'] == 'other' ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Khác</option>
 </select>
 </div>
 </div>
 <div class="col-md-6">
 <div class="mb-3">
 <label for="status" class="form-label">Trạng thái</label>
 <select class="form-select" id="status" name="status">
 <option value="assigned" <?php echo \htmlentities($assignment['status'] == 'assigned' ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Đã phân bổ</option>
 <option value="confirmed" <?php echo \htmlentities($assignment['status'] == 'confirmed' ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Đã xác nhận</option>
