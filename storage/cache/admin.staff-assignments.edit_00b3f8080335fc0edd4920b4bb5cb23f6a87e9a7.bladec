 <div class="mb-3">
 <label for="notes" class="form-label">Ghi chú</label>
 <textarea class="form-control" id="notes" name="notes" rows="3"><?php echo \htmlentities($assignment['notes']??'', ENT_QUOTES, 'UTF-8', false); ?></textarea>
