<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', $title); ?>
        
<?php $this->startSection('content'); ?>
<div class="container mt-4">
 <h2 class="mb-4"><?php echo \htmlentities($title??'', ENT_QUOTES, 'UTF-8', false); ?></h2>

 <?php if(isset($_SESSION['flash']['success'])): ?>
 <div class="alert alert-success"><?php echo \htmlentities($_SESSION['flash']['success']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php unset($_SESSION['flash']['success']);  ?>
 <?php endif; ?>
 <?php if(isset($_SESSION['flash']['error'])): ?>
 <div class="alert alert-danger"><?php echo \htmlentities($_SESSION['flash']['error']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php unset($_SESSION['flash']['error']);  ?>
 <?php endif; ?>

 <div class="card">
 <div class="card-body">
 <form action="<?php echo \htmlentities(route('admin/bookings/store')??'', ENT_QUOTES, 'UTF-8', false); ?>" method="POST">
 <div class="mb-3">
 <label class="form-label">Tour du lịch <span class="text-danger">*</span></label>
 <select name="tour_id" class="form-select" required>
 <option value="">-- Chọn Tour --</option>
 <?php $__currentLoopData = $tours; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $tour): $loop = $this->incrementLoopIndices();  ?>
 <option value="<?php echo \htmlentities($tour['id']??'', ENT_QUOTES, 'UTF-8', false); ?>"><?php echo \htmlentities($tour['name']??'', ENT_QUOTES, 'UTF-8', false); ?> (<?php echo \htmlentities(number_format($tour['price'])??'', ENT_QUOTES, 'UTF-8', false); ?> VNĐ)</option>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </select>
 </div>

 <div class="mb-3">
 <label class="form-label">Họ tên khách hàng</label>
 <input type="text" name="customer_name" class="form-control" value="<?php echo \htmlentities(isset($_POST['customer_name']) ? htmlentities($_POST['customer_name']) : ''??'', ENT_QUOTES, 'UTF-8', false); ?>" required>
 </div>

 <div class="mb-3">
 <label class="form-label">Email</label>
 <input type="email" name="customer_email" class="form-control" value="<?php echo \htmlentities(isset($_POST['customer_email']) ? htmlentities($_POST['customer_email']) : ''??'', ENT_QUOTES, 'UTF-8', false); ?>" required>
 </div>

 <div class="mb-3">
 <label class="form-label">Số điện thoại</label>
 <input type="text" name="customer_phone" class="form-control" value="<?php echo \htmlentities(isset($_POST['customer_phone']) ? htmlentities($_POST['customer_phone']) : ''??'', ENT_QUOTES, 'UTF-8', false); ?>" required>
 </div>

 <div class="mb-3">
 <label class="form-label">Số người</label>
 <input type="number" name="num_people" class="form-control" value="<?php echo \htmlentities(isset($_POST['num_people']) ? (int)$_POST['num_people'] : 1??'', ENT_QUOTES, 'UTF-8', false); ?>" min="1" required>
 </div>

 <div class="mb-3">
 <label class="form-label">Ngày đặt Tour</label>
 <input type="date" name="booking_date" class="form-control" value="<?php echo \htmlentities(isset($_POST['booking_date']) ? htmlentities($_POST['booking_date']) : date('Y-m-d')??'', ENT_QUOTES, 'UTF-8', false); ?>" required>
 </div>

 <div class="mb-3">
 <label class="form-label">Trạng thái</label>
 <select name="status" class="form-select">
 <option value="0">Chờ xác nhận</option>
 <option value="1">Đã xác nhận</option>
 <option value="2">Đã hủy</option>
 </select>
 </div>

 <div class="mb-3">
 <label class="form-label">Ghi chú</label>
 <textarea name="note" class="form-control" rows="4"><?php echo \htmlentities(isset($_POST['note']) ? htmlentities($_POST['note']) : ''??'', ENT_QUOTES, 'UTF-8', false); ?></textarea>
 </div>

 <div class="alert alert-info">
 <strong>Lưu ý:</strong> Tổng tiền sẽ được hệ thống tự động tính bằng <strong>Giá Tour × Số người</strong>
 </div>

 <div class="mt-3">
 <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> Lưu Booking</button>
 <a href="<?php echo \htmlentities(route('admin/bookings')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-secondary">Quay lại</a>
 </div>
 </form>
 </div>
 </div>
</div>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layouts.admin'); } ?>