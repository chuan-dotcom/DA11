 <?php unset($_SESSION['flash']['error']);  ?>
 <?php endif; ?>

 <div class="card">
 <div class="card-body">
 <form action="<?php echo \htmlentities(route('admin/bookings/store')??'', ENT_QUOTES, 'UTF-8', false); ?>" method="POST">
 <div class="row g-3">
 <div class="col-md-6">
 <div class="mb-0">
 <label class="form-label">Tour du lịch <span class="text-danger">*</span></label>
 <select name="tour_id" id="tour_id" class="form-select" required>
 <option value="">-- Chọn Tour --</option>
 <?php $__currentLoopData = $tours; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $tour): $loop = $this->incrementLoopIndices();  ?>
 <option value="<?php echo \htmlentities($tour['id']??'', ENT_QUOTES, 'UTF-8', false); ?>" data-price="<?php echo \htmlentities($tour['price'] ?? 0??'', ENT_QUOTES, 'UTF-8', false); ?>" <?php echo \htmlentities((isset($preTourId) && (int)$preTourId === (int)$tour['id']) ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>
 <?php echo \htmlentities($tour['name']??'', ENT_QUOTES, 'UTF-8', false); ?> (<?php echo \htmlentities(number_format($tour['price'])??'', ENT_QUOTES, 'UTF-8', false); ?> VNĐ)
 </option>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </select>
 </div>
 </div>
 <div class="col-md-6">
 <div class="mb-0">
 <label class="form-label">Chuyến khởi hành <span class="text-muted small">(tùy chọn)</span></label>
 <select name="departure_id" id="departure_id" class="form-select">
 <option value="">-- Không gắn vào đoàn --</option>
 <?php $__currentLoopData = $departures; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $d): $loop = $this->incrementLoopIndices();  ?>
 <option value="<?php echo \htmlentities($d['id']??'', ENT_QUOTES, 'UTF-8', false); ?>"
 data-tour="<?php echo \htmlentities((int)($d['tour_id'] ?? 0)??'', ENT_QUOTES, 'UTF-8', false); ?>"
 data-departure="<?php echo \htmlentities(!empty($d['departure_date']) ? date('Y-m-d', strtotime($d['departure_date'])) : ''??'', ENT_QUOTES, 'UTF-8', false); ?>"
 data-return="<?php echo \htmlentities(!empty($d['return_date']) ? date('Y-m-d', strtotime($d['return_date'])) : ''??'', ENT_QUOTES, 'UTF-8', false); ?>"
 data-meeting="<?php echo \htmlentities(!empty($d['meeting_point']) ? htmlspecialchars($d['meeting_point'], ENT_QUOTES) : ''??'', ENT_QUOTES, 'UTF-8', false); ?>"
 <?php echo \htmlentities((isset($preDepartureId) && (int)$preDepartureId === (int)$d['id']) ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>
 #<?php echo \htmlentities($d['id']??'', ENT_QUOTES, 'UTF-8', false); ?> - <?php echo \htmlentities($d['group_name'] ?? ('Đoàn ' . ($d['tour_name'] ?? 'Tour'))??'', ENT_QUOTES, 'UTF-8', false); ?> (<?php echo \htmlentities(!empty($d['departure_date']) ? date('d/m/Y', strtotime($d['departure_date'])) : '-'??'', ENT_QUOTES, 'UTF-8', false); ?>)
 </option>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </select>
 <div class="form-text small opacity-75">Chọn Tour ở trên sẽ tự lọc các chuyến khởi hành phù hợp. Nếu chọn chuyến → tự động gắn ngày khởi hành &amp; địa chỉ đón (nếu chưa điền).</div>
 </div>
 </div>
 </div>

 <div class="mb-3 mt-3">
 <label class="form-label">Họ tên khách hàng</label>
 <input type="text" name="customer_name" class="form-control" value="<?php echo \htmlentities(isset($_POST['customer_name']) ? htmlentities($_POST['customer_name']) : ''??'', ENT_QUOTES, 'UTF-8', false); ?>" required>
 </div>

 <div class="row g-3">
 <div class="col-md-6">
 <div class="mb-0">
 <label class="form-label">Email</label>
 <input type="email" name="customer_email" id="customer_email" class="form-control" value="<?php echo \htmlentities(isset($_POST['customer_email']) ? htmlentities($_POST['customer_email']) : ''??'', ENT_QUOTES, 'UTF-8', false); ?>" required>
 </div>
 </div>
 <div class="col-md-6">
 <div class="mb-0">
 <label class="form-label">Số điện thoại</label>
 <input type="text" name="customer_phone" id="customer_phone" class="form-control" value="<?php echo \htmlentities(isset($_POST['customer_phone']) ? htmlentities($_POST['customer_phone']) : ''??'', ENT_QUOTES, 'UTF-8', false); ?>" required>
 </div>
 </div>
 </div>

 <div class="mb-3 mt-3">
 <label class="form-label">Địa chỉ đón khách hàng</label>
 <input type="text" name="pickup_address" id="pickup_address" class="form-control" value="<?php echo \htmlentities(isset($_POST['pickup_address']) ? htmlentities($_POST['pickup_address']) : ''??'', ENT_QUOTES, 'UTF-8', false); ?>" placeholder="Ví dụ: Số 123 đường Nguyễn Huệ, Q.1, TP.HCM">
 </div>

 <div class="row g-3">
 <div class="col-md-6">
 <div class="mb-0">
 <label class="form-label">Số người</label>
 <input type="number" name="num_people" id="num_people" class="form-control" value="<?php echo \htmlentities(isset($_POST['num_people']) ? (int)$_POST['num_people'] : 1??'', ENT_QUOTES, 'UTF-8', false); ?>" min="1" required>
 </div>
 </div>
 <div class="col-md-6">
 <div class="mb-0">
 <label class="form-label">Ngày đặt Tour</label>
 <input type="date" name="booking_date" id="booking_date" class="form-control" value="<?php echo \htmlentities(isset($_POST['booking_date']) ? htmlentities($_POST['booking_date']) : date('Y-m-d')??'', ENT_QUOTES, 'UTF-8', false); ?>" required>
 </div>
 </div>
 </div>

 <div class="mb-3 mt-3">
 <label class="form-label">Trạng thái</label>
 <select name="status" class="form-select">
 <option value="0">Chờ xác nhận</option>
 <option value="1">Đã xác nhận</option>
 <option value="2">Đã hủy</option>
 </select>
 </div>

 <div class="mb-3">
 <label class="form-label">Ghi chú</label>
 <textarea name="note" class="form-control" rows="4"><?php echo \htmlentities(isset($_POST['note']) ? htmlentities($_POST['note']) : ''??'', ENT_QUOTES, 'UTF-8', false); ?></textarea>
 </div>

 <div class="alert alert-info">
 <strong>Lưu ý:</strong> Tổng tiền sẽ được hệ thống tự động tính bằng <strong>Giá Tour × Số người</strong>
 </div>

 <div class="mt-3">
 <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> Lưu Booking</button>
 <a href="<?php echo \htmlentities(route('admin/bookings')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-secondary">Quay lại</a>
 </div>
 </form>
 </div>
 </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
 const tourSel = document.getElementById('tour_id');
 const depSel = document.getElementById('departure_id');
 const bookingDate = document.getElementById('booking_date');
 const pickupAddr = document.getElementById('pickup_address');
 if (!tourSel || !depSel) return;

 const depOpts = Array.from(depSel.options).filter(o => o.value !== '');

 function filterDepartures() {
 const tourVal = tourSel.value ? parseInt(tourSel.value, 10) : 0;
 const prev = depSel.value;
 depSel.innerHTML = '';
 const allOpt = document.createElement('option');
 allOpt.value = '';
 allOpt.textContent = '-- Không gắn vào đoàn --';
 depSel.appendChild(allOpt);
 depOpts.forEach(o => {
 const t = parseInt(o.getAttribute('data-tour') || '0', 10);
 if (!tourVal || tourVal === t) {
 const copy = o.cloneNode(true);
 depSel.appendChild(copy);
 }
 });
 if (prev && depSel.querySelector('option[value="' + prev + '"]')) {
 depSel.value = prev;
 }
 }

 function applyDeparture(opt) {
 if (!opt || !opt.dataset) return;
 const depDate = opt.getAttribute('data-departure') || '';
 const meet = opt.getAttribute('data-meeting') || '';
 if (depDate && (!bookingDate.value || bookingDate.value === '<?php echo \htmlentities(date('Y-m-d')??'', ENT_QUOTES, 'UTF-8', false); ?>')) {
 bookingDate.value = depDate;
 }
 if (meet && !pickupAddr.value) {
 pickupAddr.value = meet;
 }
 }

 tourSel.addEventListener('change', filterDepartures);
 depSel.addEventListener('change', function() {
 const sel = this.options[this.selectedIndex];
 if (sel && sel.value) applyDeparture(sel);
 });
 filterDepartures();
 const initSel = depSel.options[depSel.selectedIndex];
 if (initSel && initSel.value) applyDeparture(initSel);
});
</script>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layouts.admin'); } ?>