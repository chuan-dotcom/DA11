<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', $title); ?>

<?php $this->startSection('content'); ?>                
<style>
 .guest-group-shell {
 background: #f7f8fb;
 border-radius: 14px;
 }

 .soft-card {
 background: #fff;
 border: 1px solid #edf0f4;
 border-radius: 14px;
 box-shadow: 0 8px 22px rgba(15, 23, 42, 0.05);
 }

 .soft-table thead th {
 font-size: 0.86rem;
 white-space: nowrap;
 }

 .soft-table tbody td {
 vertical-align: middle;
 font-size: 0.93rem;
 }

 .mini-badge {
 font-size: 0.75rem;
 padding: 5px 10px;
 border-radius: 999px;
 }
</style>

<div class="container mt-4 guest-group-shell p-3 p-md-4">
 <div class="small text-uppercase text-muted fw-semibold mb-1">Quản lý hoạt động</div>
 <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
 <h2 class="mb-0"><?php echo \htmlentities($title??'', ENT_QUOTES, 'UTF-8', false); ?></h2>
 <a href="<?php echo \htmlentities(route('admin/departures/create')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-success">
 <i class="bi bi-plus-circle"></i> Tạo đoàn khách
 </a>
 </div>

 <?php if(isset($_SESSION['flash']['success'])): ?>
 <div class="alert alert-success"><?php echo \htmlentities($_SESSION['flash']['success']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php unset($_SESSION['flash']['success']);  ?>
 <?php endif; ?>
 <?php if(isset($_SESSION['flash']['error'])): ?>
 <div class="alert alert-danger"><?php echo \htmlentities($_SESSION['flash']['error']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php unset($_SESSION['flash']['error']);  ?>
 <?php endif; ?>

 <div class="soft-card p-3 p-md-4 mb-4">
 <h5 class="mb-3">Bộ lọc</h5>
 <form method="get" class="row g-2 align-items-end">
 <div class="col-md-4">
 <label for="tour_id" class="form-label small text-muted">Tour</label>
 <select name="tour_id" id="tour_id" class="form-select">
 <option value="">-- Tất cả tour --</option>
 <?php $__currentLoopData = $tours; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $tour): $loop = $this->incrementLoopIndices();  ?>
 <option value="<?php echo \htmlentities($tour['id']??'', ENT_QUOTES, 'UTF-8', false); ?>" <?php echo \htmlentities((int) ($tourId ?? 0) === (int) $tour['id'] ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>
 <?php echo \htmlentities($tour['name']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </option>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </select>
 </div>
 <div class="col-md-4">
 <label for="status" class="form-label small text-muted">Trạng thái</label>
 <select name="status" id="status" class="form-select">
 <option value="">-- Tất cả trạng thái --</option>
 <option value="scheduled" <?php echo \htmlentities(($status ?? '') === 'scheduled' ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Chờ khởi hành</option>
 <option value="in_progress" <?php echo \htmlentities(($status ?? '') === 'in_progress' ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Đang diễn ra</option>
 <option value="completed" <?php echo \htmlentities(($status ?? '') === 'completed' ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Hoàn thành</option>
 <option value="cancelled" <?php echo \htmlentities(($status ?? '') === 'cancelled' ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Đã hủy</option>
 </select>
 </div>
 <div class="col-md-4 d-flex gap-2">
 <button type="submit" class="btn btn-primary">
 <i class="bi bi-funnel"></i> Lọc
 </button>
 <a href="<?php echo \htmlentities(route('admin/guest-groups')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-outline-secondary">Xóa lọc</a>
 </div>
 </form>
 </div>

 <div class="soft-card p-3 p-md-4">
 <h5 class="mb-3">Danh sách đoàn khách</h5>

 <div class="table-responsive">
 <table class="table soft-table align-middle">
 <thead>
 <tr>
 <th>ID</th>
 <th>Tên đoàn</th>
 <th>Tour</th>
 <th>Số khách</th>
 <th>Khởi hành</th>
 <th>Trạng thái</th>
 <th>Thao tác</th>
 </tr>
 </thead>
 <tbody>
 <?php if(empty($guestGroups)): ?>
 <tr>
 <td colspan="7" class="text-center text-muted py-4">Chưa có đoàn tour nào phù hợp.</td>
 </tr>
 <?php else: ?>
 <?php $__currentLoopData = $guestGroups; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $group): $loop = $this->incrementLoopIndices();  ?>
 <?php 
 $statusMap = [
 'scheduled' => ['Chờ khởi hành', 'bg-warning text-dark'],
 'in_progress' => ['Đang diễn ra', 'bg-primary'],
 'completed' => ['Hoàn tất', 'bg-success'],
 'cancelled' => ['Đã hủy', 'bg-secondary'],
 ];
 $statusInfo = $statusMap[$group['status']] ?? [$group['status'], 'bg-secondary'];
 $groupName = $group['group_name'] ?: ('Đoàn ' . ($group['tour_name'] ?? 'Tour #' . $group['tour_id']));
 ?>
 <tr>
 <td>#<?php echo \htmlentities($group['id']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <div class="fw-semibold"><?php echo \htmlentities($groupName??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 </td>
 <td><?php echo \htmlentities($group['tour_name'] ?? '-'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <span class="badge bg-info text-dark mini-badge">
 <?php echo \htmlentities((int) ($group['assigned_people'] ?? 0)??'', ENT_QUOTES, 'UTF-8', false); ?>/<?php echo \htmlentities((int) ($group['max_participants'] ?? 0)??'', ENT_QUOTES, 'UTF-8', false); ?>

 </span>
 </td>
 <td><?php echo \htmlentities(!empty($group['departure_date']) ? date('Y-m-d', strtotime($group['departure_date'])) : '-'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <span class="badge mini-badge <?php echo \htmlentities($statusInfo[1]??'', ENT_QUOTES, 'UTF-8', false); ?>"><?php echo \htmlentities($statusInfo[0]??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 </td>
 <td class="text-nowrap">
 <a href="<?php echo \htmlentities(route('admin/guest-groups/print/' . $group['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-outline-secondary" title="In danh sách" target="_blank">
 <i class="bi bi-printer"></i>
 </a>
 <a href="<?php echo \htmlentities(route('admin/guest-groups/show/' . $group['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-primary" title="Cập nhật">
 Cập nhật
 </a>
 <a href="<?php echo \htmlentities(route('admin/departures/delete/' . $group['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>"
 class="btn btn-sm btn-danger"
 title="Xóa"
 onclick="return confirm('Bạn có chắc muốn xóa đoàn khách này?')">
 Xóa
 </a>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php endif; ?>
 </tbody>
 </table>
 </div>
 </div>
</div>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layouts.admin'); } ?>