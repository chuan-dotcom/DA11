<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', $title); ?>

<?php $this->startSection('content'); ?>
 <div class="mb-4">
 <h1 class="h3 fw-bold mb-2">Tài khoản của tôi</h1>
 <p class="auth-muted mb-0">Bạn đã đăng nhập thành công vào hệ thống.</p>
 </div>

 <div class="bg-light rounded-4 p-4 mb-4">
 <div class="mb-3">
 <div class="text-muted small">Họ và tên</div>
 <div class="fw-semibold"><?php echo \htmlentities($user['name'] ?? ''??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 </div>
 <div class="mb-3">
 <div class="text-muted small">Email</div>
 <div class="fw-semibold"><?php echo \htmlentities($user['email'] ?? ''??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 </div>
 <div>
 <div class="text-muted small">Vai trò</div>
 <div class="fw-semibold">
 <?php if(($user['role'] ?? '') === 'admin'): ?>
 Quản trị viên
 <?php elseif(($user['role'] ?? '') === 'hdv'): ?>
 Hướng dẫn viên
 <?php else: ?>
 Người dùng
 <?php endif; ?>
 </div>
 </div>
 <?php if(($user['role'] ?? '') === 'hdv'): ?>
 <div>
 <div class="text-muted small">Hồ sơ HDV</div>
 <div class="fw-semibold"><?php echo \htmlentities($user['hdv_name'] ?? 'Chưa gán'??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 </div>
 <?php endif; ?>
 </div>

 <div class="d-grid gap-2">
 <?php if(($user['role'] ?? '') === 'admin'): ?>
 <a href="<?php echo \htmlentities(route('admin/dashboard')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-info text-white btn-lg fw-semibold">Vào trang quản trị</a>
 <?php elseif(($user['role'] ?? '') === 'hdv'): ?>
 <a href="<?php echo \htmlentities(route('hdv/dashboard')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-info text-white btn-lg fw-semibold">Vào trang HDV</a>
 <?php endif; ?>
 <a href="<?php echo \htmlentities(route('auth/logout')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-outline-danger btn-lg fw-semibold">Đăng xuất</a>
 </div>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layouts.auth'); } ?>