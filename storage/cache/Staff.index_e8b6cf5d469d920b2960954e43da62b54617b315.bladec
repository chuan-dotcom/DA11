<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', $title); ?>

<?php $this->startSection('content'); ?>
<div class="container-fluid mt-4">
 <h2 class="mb-4">
 <i class="bi bi-people-fill"></i> <?php echo \htmlentities($title??'', ENT_QUOTES, 'UTF-8', false); ?>

 </h2>                  

 <?php if(isset($_SESSION['success'])): ?>
 <div class="alert alert-success alert-dismissible fade show">
 <i class="bi bi-check-circle me-1"></i><?php echo \htmlentities($_SESSION['success']??'', ENT_QUOTES, 'UTF-8', false); ?>

 <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
 </div>
 <?php unset($_SESSION['success']);  ?>
 <?php endif; ?>
 <?php if(isset($_SESSION['error'])): ?>
 <div class="alert alert-danger alert-dismissible fade show">
 <i class="bi bi-exclamation-circle me-1"></i><?php echo \htmlentities($_SESSION['error']??'', ENT_QUOTES, 'UTF-8', false); ?>

 <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
 </div>
 <?php unset($_SESSION['error']);  ?>
 <?php endif; ?>
 <?php if(isset($_SESSION['flash']['success'])): ?>
 <div class="alert alert-success alert-dismissible fade show">
 <i class="bi bi-check-circle me-1"></i><?php echo \htmlentities($_SESSION['flash']['success']??'', ENT_QUOTES, 'UTF-8', false); ?>

 <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
 </div>
 <?php unset($_SESSION['flash']['success']);  ?>
 <?php endif; ?>
 <?php if(isset($_SESSION['flash']['error'])): ?>
 <div class="alert alert-danger alert-dismissible fade show">
 <i class="bi bi-exclamation-circle me-1"></i><?php echo \htmlentities($_SESSION['flash']['error']??'', ENT_QUOTES, 'UTF-8', false); ?>

 <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
 </div>
 <?php unset($_SESSION['flash']['error']);  ?>
 <?php endif; ?>

 <div class="mb-3">
 <a href="<?php echo \htmlentities(route('admin/staff/create')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-primary">
 <i class="bi bi-person-plus-fill"></i> Thêm mới
 </a>
 </div>

 <div class="card shadow-sm">
 <div class="card-body">
 <div class="table-responsive">
 <table class="table table-bordered table-hover align-middle">
 <thead class="table-dark">
 <tr>
 <th width="60">ID</th>
 <th>Họ tên</th>
 <th>Liên hệ</th>
 <th>Ngôn ngữ</th>
 <th>Chứng chỉ</th>
 <th>Kinh nghiệm</th>
 <th>Điểm ĐG</th>
 <th>Trạng thái</th>
 <th width="200">Thao tác</th>
 </tr>
 </thead>
 <tbody>
 <?php if(empty($staffs)): ?>
 <tr>
 <td colspan="9" class="text-center py-4 text-muted">
 <i class="bi bi-inbox fs-2 d-block mb-2"></i>
 Chưa có dữ liệu Hướng dẫn viên
 </td>
 </tr>
 <?php else: ?>
 <?php $__currentLoopData = $staffs; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $s): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td class="fw-semibold text-center"><?php echo \htmlentities($s['HDV_id']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <a href="<?php echo \htmlentities(route('admin/staff/show/' . $s['HDV_id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="text-decoration-none fw-semibold text-dark">
 <?php echo \htmlentities($s['Hoten']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </a>
 <?php if($s['Gioitinh']): ?>
 <small class="text-muted d-block">(<?php echo \htmlentities($s['Gioitinh']??'', ENT_QUOTES, 'UTF-8', false); ?>)</small>
 <?php endif; ?>
 </td>
 <td><?php echo \htmlentities($s['Lienhe'] ?: '<span class="text-muted">—</span>'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <?php if($s['Ngonngu']): ?>
 <span class="badge bg-info text-dark"><?php echo \htmlentities($s['Ngonngu']??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 <?php else: ?>
 <span class="text-muted">—</span>
 <?php endif; ?>
 </td>
 <td><?php echo \htmlentities($s['chungchiHDV'] ?: '<span class="text-muted">—</span>'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td class="text-center">
 <?php echo \htmlentities($s['Kinhnghiem'] ? $s['Kinhnghiem'] . ' năm' : '0 năm'??'', ENT_QUOTES, 'UTF-8', false); ?>

 </td>
 <td class="text-center">
 <?php if($s['Diemdanhgia']): ?>
 <span class="badge bg-warning text-dark">
 <i class="bi bi-star-fill me-1"></i><?php echo \htmlentities(number_format($s['Diemdanhgia'], 1)??'', ENT_QUOTES, 'UTF-8', false); ?>

 </span>
 <?php else: ?>
 <span class="text-muted">—</span>
 <?php endif; ?>
 </td>
 <td>
 <?php if($s['Status'] == 'active'): ?>
 <span class="badge bg-success px-3 py-2">
 <i class="bi bi-check-circle me-1"></i>Đang làm việc (Active)
 </span>
 <?php elseif($s['Status'] == 'on_leave'): ?>
 <span class="badge bg-warning text-dark px-3 py-2">
 <i class="bi bi-clock-history me-1"></i>Nghỉ phép (On Leave)
 </span>
 <?php else: ?>
 <span class="badge bg-secondary px-3 py-2">
 <i class="bi bi-x-circle me-1"></i>Đã nghỉ (Inactive)
 </span>
 <?php endif; ?>
 </td>
 <td class="text-nowrap">
 <a href="<?php echo \htmlentities(route('admin/staff/show/' . $s['HDV_id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-info text-white" title="Xem">
 <i class="bi bi-eye"></i> Xem
 </a>
 <a href="<?php echo \htmlentities(route('admin/staff/edit/' . $s['HDV_id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-warning" title="Sửa">
 <i class="bi bi-pencil"></i> Sửa
 </a>
 <a href="<?php echo \htmlentities(route('admin/staff/delete/' . $s['HDV_id'])??'', ENT_QUOTES, 'UTF-8', false); ?>"
 class="btn btn-sm btn-danger"
 title="Xóa"
 onclick="return confirm('Bạn có chắc muốn xóa Hướng dẫn viên này?')">
 <i class="bi bi-trash"></i> Xóa
 </a>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php endif; ?>
 </tbody>
 </table>
 </div>
 </div>
 <div class="card-footer bg-light py-2">
 <small class="text-muted">
 <i class="bi bi-info-circle me-1"></i>
 Tổng số Hướng dẫn viên: <strong><?php echo \htmlentities(count($staffs)??'', ENT_QUOTES, 'UTF-8', false); ?></strong>
 </small>
 </div>
 </div>
</div>
<?php $this->stopSection(); ?>

