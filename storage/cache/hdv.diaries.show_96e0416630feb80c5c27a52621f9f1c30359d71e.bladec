 <h3 class="fw-bold text-dark mb-1"><?php echo \htmlentities($diary['title']??'', ENT_QUOTES, 'UTF-8', false); ?></h3>
 <div class="text-muted small">Tour: <strong><?php echo \htmlentities($diary['tour_name']??'', ENT_QUOTES, 'UTF-8', false); ?></strong> | Danh mục: <strong><?php echo \htmlentities($diary['category_name'] ?? 'Chưa phân loại'??'', ENT_QUOTES, 'UTF-8', false); ?></strong></div>
 <div class="text-muted small">
 Đoàn: <strong><?php echo \htmlentities($diary['departure_group_name'] ?: ('Chuyến khởi hành #' . $diary['departure_id'])??'', ENT_QUOTES, 'UTF-8', false); ?></strong>
 <?php if(!empty($diary['tour_departure_date'])): ?>
 | Khởi hành: <strong><?php echo \htmlentities(date('d/m/Y', strtotime($diary['tour_departure_date']))??'', ENT_QUOTES, 'UTF-8', false); ?></strong>
 <?php endif; ?>
 </div>
 </div>
 <div class="d-flex gap-2">
 <a href="<?php echo \htmlentities(route('hdv/nhat-ky-tour/edit/' . $diary['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-warning rounded-pill px-3 fw-bold">
 <i class="bi bi-pencil me-1"></i> Chỉnh sửa
 </a>
 <a href="<?php echo \htmlentities(route('hdv/nhat-ky-tour')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-outline-secondary rounded-pill px-3">
 <i class="bi bi-arrow-left me-1"></i> Quay lại
 </a>
 </div>
 </div>
</div>

<div class="row g-4">
 <div class="col-lg-8">
 <div class="hdv-card">
 <div class="d-flex gap-3 mb-4">
 <?php if(!empty($diary['weather'])): ?>
 <div class="bg-info-subtle text-info-emphasis rounded-3 px-3 py-2 fw-semibold">
 <i class="bi bi-cloud-sun me-1"></i> Thời tiết: <?php echo \htmlentities($diary['weather']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </div>
 <?php endif; ?>
 <?php if(!empty($diary['mood'])): ?>
 <div class="bg-warning-subtle text-warning-emphasis rounded-3 px-3 py-2 fw-semibold">
 <i class="bi bi-emoji-smile me-1"></i> Không khí: <?php echo \htmlentities($diary['mood']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </div>
 <?php endif; ?>
 </div>

 <div class="fs-6 lh-lg text-dark mb-4 style-content">
 <?php echo nl2br(e($diary['content'])); ?>

 </div>

 <?php if(!empty($photos)): ?>
 <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="bi bi-images me-1"></i> Hình ảnh ghi nhận (<?php echo \htmlentities(count($photos)??'', ENT_QUOTES, 'UTF-8', false); ?>)</h6>
 <div class="row g-3">
 <?php $__currentLoopData = $photos; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $photo): $loop = $this->incrementLoopIndices();  ?>
 <div class="col-md-4">
 <a href="<?php echo \htmlentities(file_url($photo)??'', ENT_QUOTES, 'UTF-8', false); ?>" target="_blank">
 <img src="<?php echo \htmlentities(file_url($photo)??'', ENT_QUOTES, 'UTF-8', false); ?>" class="img-fluid rounded-3 shadow-sm hover-zoom" style="height: 180px; width: 100%; object-fit: cover;">
 </a>
 </div>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </div>
 <?php endif; ?>
 </div>
 </div>

 <div class="col-lg-4">
 <div class="hdv-card">
 <h6 class="fw-bold text-dark mb-3"><i class="bi bi-diagram-3 text-primary me-2"></i> Liên kết nghiệp vụ</h6>
