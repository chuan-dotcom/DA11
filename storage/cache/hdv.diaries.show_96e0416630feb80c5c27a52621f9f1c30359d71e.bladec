 </div>

 <h6 class="fw-bold text-dark mb-3"><i class="bi bi-person-badge text-primary me-2"></i> Người thực hiện</h6>
 <div class="p-3 bg-light rounded-3 mb-3">
 <div class="fw-bold"><?php echo \htmlentities($diary['author_hdv_name'] ?? 'Chưa lưu người viết'??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <div class="text-muted small">SĐT: <?php echo \htmlentities($diary['author_hdv_phone'] ?? '—'??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <div class="text-muted small">Chứng chỉ: <?php echo \htmlentities($diary['author_hdv_certificate'] ?? '—'??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php if(empty($diary['author_hdv_name'])): ?>
 <div class="text-muted small mt-2">Nhật ký cũ này chưa có dữ liệu người viết trước khi hệ thống bổ sung tính năng lưu tác giả.</div>
 <?php endif; ?>
 </div>

 <div class="small text-muted border-top pt-3">
 <div><i class="bi bi-clock me-1"></i> Ngày tạo bài: <?php echo \htmlentities(date('d/m/Y H:i', strtotime($diary['created_at']))??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php if(!empty($diary['updated_at'])): ?>
 <div><i class="bi bi-arrow-repeat me-1"></i> Cập nhật gần nhất: <?php echo \htmlentities(date('d/m/Y H:i', strtotime($diary['updated_at']))??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php endif; ?>
 </div>
 </div>
 </div>
</div>

