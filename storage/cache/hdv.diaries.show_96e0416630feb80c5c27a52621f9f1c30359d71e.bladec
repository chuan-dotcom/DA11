 <div class="text-muted small">Chuyến: <?php echo \htmlentities($diary['departure_group_name'] ?: ('#' . $diary['departure_id'])??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <div class="text-muted small">Điểm hẹn: <?php echo \htmlentities($diary['meeting_point'] ?? '—'??'', ENT_QUOTES, 'UTF-8', false); ?></div>
