 <?php /* ======== BẢNG TOUR ĐÃ HOÀN THÀNH ======== */ ?>
 <?php /*
 Lấy từ bookings JOIN tours JOIN tour_categories (status booking = 1)
 Nhóm theo tour, tính tổng booking + doanh thu + ngày cuối
 */ ?>
 <div class="section-card">
 <div class="section-title mb-3">Tour đã hoàn thành</div>
 <div class="table-responsive">
 <table class="table table-bordered mb-0">
 <thead class="table-light">
 <tr>
 <th>Tên tour</th>
 <th>Danh mục</th>
 <th class="text-center">Số booking</th>
 <th>Doanh thu</th>
 <th>Ngày booking cuối</th>
 <th>Sự cố xảy ra</th>
 <th>Chi tiết</th>
 </tr>
 </thead>
 <tbody>
 <?php 
 $groupedCompleted = [];
 foreach ($completedBookings as $bk) {
 $tid = $bk['tour_id'];
 if (!isset($groupedCompleted[$tid])) {
 $groupedCompleted[$tid] = [
 'tour_id'       => $tid,
 'tour_name'     => $bk['tour_name'],
 'category_name' => $bk['category_name'] ?? 'Chưa phân loại',
 'count'         => 0,
 'revenue'       => 0,
 'last_date'     => $bk['booking_date'],
 ];
 }
 $groupedCompleted[$tid]['count']++;
 $groupedCompleted[$tid]['revenue'] += (int) $bk['total_price'];
 if ($bk['booking_date'] > $groupedCompleted[$tid]['last_date']) {
 $groupedCompleted[$tid]['last_date'] = $bk['booking_date'];
 }
 }
 ?>

 <?php if(empty($groupedCompleted)): ?>
 <tr>
 <td colspan="7" class="text-center text-muted py-3">Chưa có booking nào hoàn thành.</td>
 </tr>
 <?php else: ?>
 <?php $__currentLoopData = $groupedCompleted; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $row): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td class="fw-semibold">
 <a href="<?php echo \htmlentities(route('admin/tours/show/' . $row['tour_id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="text-decoration-none text-dark">
 <?php echo \htmlentities($row['tour_name']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </a>
 </td>
 <td><?php echo \htmlentities($row['category_name']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td class="text-center">
 <span class="badge bg-info text-dark"><?php echo \htmlentities($row['count']??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 </td>
 <td class="fw-bold text-success"><?php echo \htmlentities(number_format($row['revenue'])??'', ENT_QUOTES, 'UTF-8', false); ?>đ</td>
 <td><?php echo \htmlentities(date('d/m/Y', strtotime($row['last_date']))??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><span class="badge bg-success">Không có</span></td>
 <td>
 <a href="<?php echo \htmlentities(route('admin/tours/show/' . $row['tour_id'])??'', ENT_QUOTES, 'UTF-8', false); ?>"
 class="btn btn-sm btn-outline-primary py-0 px-2">Xem</a>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php endif; ?>
 </tbody>
 </table>
 </div>
 </div>

 <?php /* ======== BẢNG QUẢN LÝ DANH SÁCH TOUR ======== */ ?>
 <?php /*
 Lấy từ tours JOIN tour_categories + LEFT JOIN bookings
 Hiển thị: tên tour, danh mục, thời gian, giá, số booking (đã hoàn thành), doanh thu, trạng thái tour
 */ ?>
 <div class="section-card">
 <div class="d-flex justify-content-between align-items-center mb-3">
 <span class="section-title">Quản lý danh sách Tour</span>
 <a href="<?php echo \htmlentities(route('admin/tours/create')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-success">+ Thêm tour</a>
 </div>
 <div class="table-responsive">
 <table class="table table-bordered mb-0">
 <thead class="table-light">
 <tr>
 <th>Tên tour</th>
 <th>Danh mục</th>
 <th>Thời gian</th>
 <th>Giá tour</th>
 <th class="text-center">Số booking</th>
 <th>Doanh thu</th>
 <th>Trạng thái</th>
 <th class="text-center">Thao tác</th>
 </tr>
 </thead>
 <tbody>
 <?php if(empty($revenueByTour)): ?>
 <tr>
 <td colspan="8" class="text-center text-muted py-3">Chưa có tour nào.</td>
 </tr>
 <?php else: ?>
 <?php $__currentLoopData = $revenueByTour; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $t): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td class="fw-semibold">
 <a href="<?php echo \htmlentities(route('admin/tours/show/' . ($t['tour_id'] ?? ''))??'', ENT_QUOTES, 'UTF-8', false); ?>" class="text-decoration-none text-dark">
 <?php echo \htmlentities($t['tour_name'] ?? '—'??'', ENT_QUOTES, 'UTF-8', false); ?>

 </a>
 </td>
 <td><?php echo \htmlentities($t['category_name'] ?? '—'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($t['duration'] ?? '—'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities(number_format((float)($t['unit_price'] ?? 0))??'', ENT_QUOTES, 'UTF-8', false); ?>đ</td>
 <td class="text-center">
 <?php if(($t['booking_count'] ?? 0) > 0): ?>
 <span class="badge bg-primary"><?php echo \htmlentities($t['booking_count']??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 <?php else: ?>
 <span class="text-muted">0</span>
 <?php endif; ?>
 </td>
 <td>
 <?php if(($t['revenue'] ?? 0) > 0): ?>
 <span class="text-success fw-bold"><?php echo \htmlentities(number_format((float)($t['revenue'] ?? 0))??'', ENT_QUOTES, 'UTF-8', false); ?>đ</span>
 <?php else: ?>
 <span class="text-muted">0đ</span>
 <?php endif; ?>
 </td>
 <td>
 <?php if(($t['status'] ?? 0) == 1): ?>
 <span class="badge bg-success">Hiển thị</span>
 <?php else: ?>
 <span class="badge bg-secondary">Ẩn</span>
 <?php endif; ?>
 </td>
 <td class="text-center">
 <a href="<?php echo \htmlentities(route('admin/tours/show/' . ($t['tour_id'] ?? ''))??'', ENT_QUOTES, 'UTF-8', false); ?>"
 class="btn btn-sm btn-outline-info py-0 px-2" title="Xem">
 <i class="bi bi-eye"></i>
 </a>
 <a href="<?php echo \htmlentities(route('admin/tours/edit/' . ($t['tour_id'] ?? ''))??'', ENT_QUOTES, 'UTF-8', false); ?>"
 class="btn btn-sm btn-outline-warning py-0 px-2" title="Sửa">
 <i class="bi bi-pencil"></i>
 </a>
 <a href="<?php echo \htmlentities(route('admin/tours/delete/' . ($t['tour_id'] ?? ''))??'', ENT_QUOTES, 'UTF-8', false); ?>"
 class="btn btn-sm btn-outline-danger py-0 px-2"
 onclick="return confirm('Xóa tour này sẽ xóa luôn các booking liên quan. Tiếp tục?')"
 title="Xóa">
 <i class="bi bi-trash"></i>
 </a>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php endif; ?>
 </tbody>
 </table>
 </div>
 <div class="mt-2 text-muted" style="font-size:.78rem;">
 Tổng: <strong><?php echo \htmlentities($totalTours??'', ENT_QUOTES, 'UTF-8', false); ?></strong> tour &nbsp;|&nbsp;
 Hiển thị: <strong class="text-success"><?php echo \htmlentities($totalActiveTours??'', ENT_QUOTES, 'UTF-8', false); ?></strong> &nbsp;|&nbsp;
 Đang ẩn: <strong class="text-secondary"><?php echo \htmlentities($totalTours - $totalActiveTours??'', ENT_QUOTES, 'UTF-8', false); ?></strong> &nbsp;|&nbsp;
 Danh mục: <strong><?php echo \htmlentities($totalCategories??'', ENT_QUOTES, 'UTF-8', false); ?></strong>
 </div>
 </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
 // ---- Biểu đồ line: số booking theo ngày ----
 new Chart(document.getElementById('chartBookings').getContext('2d'), {
 type: 'line',
 data: {
 labels: <?php echo json_encode($chartLabels); ?>,
 datasets: [{
 label: 'Số booking',
 data: <?php echo json_encode($chartBookings); ?>,
 borderColor: '#4a6cf7',
 backgroundColor: 'rgba(74, 108, 247, 0.10)',
 borderWidth: 2,
 pointRadius: 3,
 pointBackgroundColor: '#4a6cf7',
 fill: true,
 tension: 0.4
 }]
 },
 options: {
 responsive: true,
 plugins: { legend: { display: false } },
 scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
 }
 });

 // ---- Biểu đồ donut: tour theo danh mục ----
 <?php if(!empty($catChartCounts) && array_sum($catChartCounts) > 0): ?>
 new Chart(document.getElementById('chartCategory').getContext('2d'), {
 type: 'doughnut',
 data: {
 labels: <?php echo json_encode($catChartLabels, JSON_UNESCAPED_UNICODE); ?>,
 datasets: [{
 data: <?php echo json_encode($catChartCounts); ?>,
 backgroundColor: ['#4a6cf7','#f59e0b','#16a34a','#9333ea','#ef4444','#06b6d4'],
 borderWidth: 2,
 borderColor: '#fff'
 }]
 },
 options: {
 responsive: true,
 plugins: {
 legend: { position: 'bottom', labels: { font: { size: 11 }, boxWidth: 12 } }
 },
 cutout: '60%'
 }
 });
 <?php endif; ?>

 // ---- Biểu đồ bar: doanh thu theo ngày ----
 new Chart(document.getElementById('chartRevenue').getContext('2d'), {
 type: 'bar',
 data: {
 labels: <?php echo json_encode($chartLabels); ?>,
 datasets: [{
 label: 'Doanh thu (đ)',
 data: <?php echo json_encode($chartRevenue); ?>,
 backgroundColor: 'rgba(134, 239, 172, 0.75)',
 borderColor: '#16a34a',
 borderWidth: 1,
 borderRadius: 4
 }]
 },
 options: {
 responsive: true,
 plugins: { legend: { display: false } },
 scales: {
 y: {
 beginAtZero: true,
 ticks: {
 callback: function(v) {
 if (v >= 1000000) return (v/1000000).toFixed(0) + 'M';
 if (v >= 1000)    return (v/1000).toFixed(0) + 'K';
 return v;
 }
 }
 }
 }
 }
 });
</script>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layouts.admin'); } ?>