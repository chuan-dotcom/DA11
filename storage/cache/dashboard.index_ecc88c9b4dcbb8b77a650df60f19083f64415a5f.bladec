 foreach($__currentLoopData as $i => $label): $loop = $this->incrementLoopIndices();  ?>
 <li class="d-flex justify-content-between py-1 border-bottom">
 <span><?php echo \htmlentities($label??'', ENT_QUOTES, 'UTF-8', false); ?></span>
