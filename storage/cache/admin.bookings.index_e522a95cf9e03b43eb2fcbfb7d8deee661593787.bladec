 <option value="">Tất cả</option>
 <?php $__currentLoopData = $departures; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $d): $loop = $this->incrementLoopIndices();  ?>
 <option value="<?php echo \htmlentities($d['id']??'', ENT_QUOTES, 'UTF-8', false); ?>" data-tour="<?php echo \htmlentities((int)($d['tour_id'] ?? 0)??'', ENT_QUOTES, 'UTF-8', false); ?>" <?php echo \htmlentities((isset($departureId) && (int)$departureId === (int)$d['id']) ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>
 #<?php echo \htmlentities($d['id']??'', ENT_QUOTES, 'UTF-8', false); ?> - <?php echo \htmlentities($d['group_name'] ?? ('Đoàn ' . ($d['tour_name'] ?? 'Tour'))??'', ENT_QUOTES, 'UTF-8', false); ?> (<?php echo \htmlentities(!empty($d['departure_date']) ? date('d/m/Y', strtotime($d['departure_date'])) : '-'??'', ENT_QUOTES, 'UTF-8', false); ?>)
 </option>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </select>
 <div class="form-text small opacity-75">Chọn Tour ở trên sẽ tự lọc chuyến khởi hành phù hợp</div>
 </div>
 <div>
 <label for="filter_status" class="form-label small mb-1">Trạng thái</label>
 <select name="status" id="filter_status" class="form-select form-select-sm">
 <option value="">Tất cả</option>
 <option value="0" <?php echo \htmlentities((isset($status) && (string)$status === '0') ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Chờ xác nhận</option>
 <option value="1" <?php echo \htmlentities((isset($status) && (string)$status === '1') ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Đã xác nhận</option>
 <option value="2" <?php echo \htmlentities((isset($status) && (string)$status === '2') ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Đã hủy</option>
 </select>
 </div>
 <button type="submit" class="btn btn-outline-primary btn-sm">
