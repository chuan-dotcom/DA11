 </a>
 </div>
 </div>
 <?php else: ?>
 <div class="d-flex flex-column gap-1">
 <span class="text-muted small">Chưa gắn vào đoàn</span>
 <a href="<?php echo \htmlentities(route('admin/guest-groups/show/' . (int)$booking['tour_id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-outline-success w-100">
 <i class="bi bi-link-45deg me-1"></i>Gắn vào đoàn
 </a>
 </div>
 <?php endif; ?>
 </td>
