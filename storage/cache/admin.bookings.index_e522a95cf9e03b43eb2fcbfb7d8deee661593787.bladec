 <?php endif; ?>
 </div>
 <?php 
 $ds = !empty($booking['departure_status']) ? $departureStatusMap[$booking['departure_status']] ?? null : null;
 ?>
 <?php if($ds): ?>
 <div><span class="badge <?php echo \htmlentities($ds[1]??'', ENT_QUOTES, 'UTF-8', false); ?>" style="width:fit-content"><?php echo \htmlentities($ds[0]??'', ENT_QUOTES, 'UTF-8', false); ?></span></div>
 <?php endif; ?>
 <div class="d-flex flex-wrap gap-1 mt-1">
 <a href="<?php echo \htmlentities(route('admin/departures/edit/' . (int)$booking['departure_id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-outline-primary">
