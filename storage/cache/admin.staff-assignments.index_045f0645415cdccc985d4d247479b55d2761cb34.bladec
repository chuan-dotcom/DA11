 <tbody>
 <?php if(empty($assignments)): ?>
 <tr>
 <td colspan="8" class="text-center">Chưa có phân bổ nào</td>
 </tr>
 <?php else: ?>
 <?php 
 $roleText = [
 'lead_guide' => 'HDV chính',
 'assistant_guide' => 'HDV phụ',
 'driver' => 'Lái xe',
 'photographer' => 'Nhiếp ảnh',
 'other' => 'Khác'
 ];
 $statusText = [
 'assigned' => 'Đã phân bổ',
 'confirmed' => 'Đã xác nhận',
 'completed' => 'Hoàn thành',
 'rejected' => 'Từ chối'
 ];
 ?>
 <?php $__currentLoopData = $assignments; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $a): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td><?php echo \htmlentities($a['id']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <a href="<?php echo \htmlentities(route('admin/departures/show/' . $a['departure_id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="fw-semibold text-decoration-none text-dark">
 <?php echo \htmlentities($a['tour_name'] ?? 'N/A'??'', ENT_QUOTES, 'UTF-8', false); ?>

 </a>
 </td>
 <td><?php echo \htmlentities($a['departure_date'] ? date('d/m/Y', strtotime($a['departure_date'])) : '-'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <span class="fw-semibold"><?php echo \htmlentities($a['staff_name'] ?? 'N/A'??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 </td>
 <td>
 <span class="badge role-<?php echo \htmlentities($a['role']??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php echo \htmlentities($roleText[$a['role']] ?? $a['role']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </span>
 </td>
 <td>
 <span class="badge status-<?php echo \htmlentities($a['status']??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php echo \htmlentities($statusText[$a['status']] ?? $a['status']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </span>
 </td>
 <td><?php echo \htmlentities($a['assigned_at'] ? date('d/m/Y H:i', strtotime($a['assigned_at'])) : '-'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td class="text-nowrap">
 <a href="<?php echo \htmlentities(route('admin/staff-assignments/show/' . $a['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-info text-white">
 <i class="bi bi-eye"></i>
 </a>
 <a href="<?php echo \htmlentities(route('admin/staff-assignments/edit/' . $a['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-warning">
 <i class="bi bi-pencil"></i>
 </a>
 <a href="<?php echo \htmlentities(route('admin/staff-assignments/delete/' . $a['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>"
 class="btn btn-sm btn-danger"
 onclick="return confirm('Bạn có chắc muốn xóa phân bổ này?')">
 <i class="bi bi-trash"></i>
 </a>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php endif; ?>
