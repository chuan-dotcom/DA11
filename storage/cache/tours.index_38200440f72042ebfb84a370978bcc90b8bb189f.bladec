<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', $title); ?>

<?php $this->startSection('content'); ?>
<div class="container mt-4">
 <h2 class="mb-4"><?php echo \htmlentities($title??'', ENT_QUOTES, 'UTF-8', false); ?></h2>

 <?php if(isset($_SESSION['success'])): ?>
 <div class="alert alert-success"><?php echo \htmlentities($_SESSION['success']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php unset($_SESSION['success']);  ?>
 <?php endif; ?>
 <?php if(isset($_SESSION['error'])): ?>
 <div class="alert alert-danger"><?php echo \htmlentities($_SESSION['error']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php unset($_SESSION['error']);  ?>
 <?php endif; ?>

 <div class="mb-3">
 <a href="<?php echo \htmlentities(route('admin/tours/create')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-primary">
 <i class="bi bi-plus"></i> Thêm mới tour
 </a>
 </div>

 <div class="card">
 <div class="card-body">
 <div class="table-responsive">
 <table class="table table-bordered table-hover">
 <thead class="table-dark">
 <tr>
 <th>ID</th>
 <th>Ảnh</th>
 <th>Tên tour</th>
 <th>Danh mục</th>
 <th>Giá</th>
 <th>Thời gian</th>
 <th>Trạng thái</th>
 <th>Thao tác</th>
 </tr>
 </thead>
 <tbody>
 <?php if(empty($tours)): ?>
 <tr>
 <td colspan="8" class="text-center">Chưa có tour nào</td>
 </tr>
 <?php else: ?>
 <?php $__currentLoopData = $tours; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $tour): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td><?php echo \htmlentities($tour['id']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <?php if($tour['image']): ?>
 <img src="<?php echo \htmlentities(file_url($tour['image'])??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="<?php echo \htmlentities($tour['name']??'', ENT_QUOTES, 'UTF-8', false); ?>" style="width: 100px; height: 70px; object-fit: cover;">
 <?php else: ?>
 <span class="text-muted">Không có ảnh</span>
 <?php endif; ?>
 </td>
 <td><?php echo \htmlentities($tour['name']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($tour['category_name']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td class="text-danger"><?php echo \htmlentities(number_format($tour['price'])??'', ENT_QUOTES, 'UTF-8', false); ?> VNĐ</td>
 <td><?php echo \htmlentities($tour['duration']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <?php if($tour['status'] == 1): ?>
 <span class="badge bg-success">Hiển thị</span>
 <?php else: ?>
 <span class="badge bg-secondary">Ẩn</span>
 <?php endif; ?>
 </td>
 <td>
 <a href="<?php echo \htmlentities(route('admin/tours/show/' . $tour['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-info">
 <i class="bi bi-eye"></i>
 </a>
 <a href="<?php echo \htmlentities(route('admin/tours/edit/' . $tour['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-warning">
 <i class="bi bi-pencil"></i>
 </a>
 <a href="<?php echo \htmlentities(route('admin/tours/delete/' . $tour['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" 
 class="btn btn-sm btn-danger" 
 onclick="return confirm('Bạn có chắc muốn xóa tour này?')">
 <i class="bi bi-trash"></i>
 </a>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php endif; ?>
 </tbody>
 </table>
 </div>
 </div>
 </div>
</div>
<?php $this->stopSection(); ?>
<?php if (isset($_shouldextend[1])) { echo $this->runChild('layouts.admin'); } ?>