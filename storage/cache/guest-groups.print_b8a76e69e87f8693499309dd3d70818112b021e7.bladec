<!DOCTYPE html>
<html lang="vi">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title><?php echo \htmlentities($title??'', ENT_QUOTES, 'UTF-8', false); ?></title>
 <style>
 body {
 font-family: Arial, sans-serif;
 color: #111;
 margin: 0;
 padding: 24px;
 background: #fff;
 }
               
 .print-wrap {
 max-width: 900px;
 margin: 0 auto;
 }

 .text-center {
 text-align: center;
 }

 .meta {
 margin: 18px 0 14px;
 font-size: 14px;
 line-height: 1.7;
 }

 table {
 width: 100%;
 border-collapse: collapse;
 margin-top: 10px;
 font-size: 13px;
 }

 th, td {
 border: 1px solid #333;
 padding: 8px 6px;
 text-align: left;
 vertical-align: top;
 }

 th {
 background: #f3f3f3;
 }

 .sign {
 margin-top: 48px;
 width: 240px;
 margin-left: auto;
 text-align: center;
 font-size: 14px;
 }

 @media print {
 body {
 padding: 0;
 }
 }
 </style>
</head>
<body>
 <?php 
 $groupName = $guestGroup['group_name'] ?: ('Đoàn ' . ($guestGroup['tour_name'] ?? 'Tour #' . $guestGroup['tour_id']));
 ?>
 <div class="print-wrap">
 <div class="text-center">
 <div style="font-weight: 700; font-size: 20px;">DANH SÁCH KHÁCH ĐOÀN</div>
 <div style="margin-top: 6px; font-size: 15px;"><?php echo \htmlentities($groupName??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 </div>

 <div class="meta">
 <div><strong>Tour:</strong> <?php echo \htmlentities($guestGroup['tour_name'] ?? '-'??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <div><strong>Ngày khởi hành:</strong> <?php echo \htmlentities(!empty($guestGroup['departure_date']) ? date('d/m/Y', strtotime($guestGroup['departure_date'])) : '-'??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <div><strong>Điểm tập trung:</strong> <?php echo \htmlentities($guestGroup['meeting_point'] ?: 'Chưa cập nhật'??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <div><strong>Tổng số khách:</strong> <?php echo \htmlentities((int) ($stats['total_people'] ?? 0)??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 </div>

 <table>
 <thead>
 <tr>
 <th>STT</th>
 <th>Mã booking</th>
 <th>Tên khách</th>
 <th>Số lượng</th>
 <th>Email</th>
 <th>SĐT</th>
 <th>Check-in</th>
 </tr>
 </thead>
 <tbody>
 <?php if(empty($bookings)): ?>
 <tr>
 <td colspan="7" class="text-center">Chưa có khách trong đoàn</td>
 </tr>
 <?php else: ?>
 <?php $__currentLoopData = $bookings; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $index => $booking): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td><?php echo \htmlentities($index + 1??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>#<?php echo \htmlentities($booking['id']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($booking['customer_name']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($booking['num_people']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($booking['customer_email']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($booking['customer_phone']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities((int) ($booking['check_in_status'] ?? 0) === 1 ? 'Đã check-in' : 'Chưa check-in'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php endif; ?>
 </tbody>
 </table>

 <div class="sign">
 <div>Ngày <?php echo \htmlentities(date('d')??'', ENT_QUOTES, 'UTF-8', false); ?> tháng <?php echo \htmlentities(date('m')??'', ENT_QUOTES, 'UTF-8', false); ?> năm <?php echo \htmlentities(date('Y')??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <div style="margin-top: 14px; font-weight: 600;">Người lập danh sách</div>
 <div style="margin-top: 72px;">__________________</div>
 </div>
 </div>

 <script>
 window.addEventListener('load', function () {
 window.print();
 });
 </script>
</body>
</html>
