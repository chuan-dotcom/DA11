 <div class="table-responsive">
 <table class="table table-hdv table-hover align-middle">
 <thead>
 <tr>
 <th>ID</th>
 <th>Tên đoàn</th>
 <th>Tour</th>
 <th class="text-center">Số khách</th>
 <th class="text-center">Check-in</th>
 <th>Điểm hẹn</th>
 <th>Ngày khởi hành</th>
 <th>Trạng thái</th>
 <th class="text-center">Thao tác</th>
 </tr>
 </thead>
 <tbody>
 <?php if(empty($assignedTours)): ?>
 <tr>
 <td colspan="9" class="text-center py-5 text-muted">
 Chưa có đoàn tour nào được phân công. Vui lòng liên hệ quản trị viên để được phân công cho chuyến khởi hành.
 </td>
 </tr>
 <?php else: ?>
 <?php $__currentLoopData = $assignedTours; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $t): $loop = $this->incrementLoopIndices();  ?>
 <?php 
 $statusMap = [
 'scheduled' => ['Chờ khởi hành', 'bg-warning text-dark'],
 'in_progress' => ['Đang diễn ra', 'bg-primary'],
 'completed' => ['Hoàn tất', 'bg-success'],
 'cancelled' => ['Đã hủy', 'bg-secondary'],
 ];
 $statusInfo = $statusMap[$t['departure_status']] ?? [$t['departure_status'], 'bg-secondary'];
 $groupName = $t['group_name'] ?: ('Đoàn ' . ($t['tour_name'] ?? 'Tour #' . $t['tour_id']));
 $assignedPeople = (int)($t['assigned_people'] ?? 0);
 $maxPeople = (int)($t['max_participants'] ?? 0);
 $checkedIn = (int)($t['checked_in_guests'] ?? 0);
 $totalGuests = (int)($t['total_guests'] ?? 0);
 $roleMap = [
 'lead_guide' => 'HDV chính',
 'assistant_guide' => 'HDV phụ',
 'driver' => 'Lái xe',
 'other' => 'Nhân sự',
 ];
 $roleLabel = $roleMap[$t['hdv_role']] ?? $t['hdv_role'];
 ?>
 <tr class="<?php echo \htmlentities((int)$selectedDepartureId === (int)$t['departure_id'] ? 'table-primary' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <td class="fw-bold text-dark">#<?php echo \htmlentities($t['departure_id']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <div class="fw-semibold text-dark"><?php echo \htmlentities($groupName??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <div class="text-muted small mt-1">
 <i class="bi bi-person-badge me-1"></i>Vai trò:
 <span class="badge bg-info-subtle text-dark"><?php echo \htmlentities($roleLabel??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 </div>
 <?php if(!empty($t['assignment_notes'])): ?>
 <div class="text-muted small mt-1"><i class="bi bi-chat-left-text me-1"></i><?php echo \htmlentities($t['assignment_notes']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php endif; ?>
 </td>
 <td>
 <div class="fw-bold text-dark"><?php echo \htmlentities($t['tour_name']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <div class="text-muted small mt-1">Danh mục: <?php echo \htmlentities($t['category_name'] ?: 'Chưa phân loại'??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php if($t['total_bookings'] > 0): ?>
 <div class="text-muted small mt-1"><i class="bi bi-receipt me-1"></i><?php echo \htmlentities((int)$t['total_bookings']??'', ENT_QUOTES, 'UTF-8', false); ?> booking</div>
 <?php endif; ?>
 </td>
 <td class="text-center">
 <span class="badge bg-info text-dark rounded-pill px-3 py-2">
 <?php echo \htmlentities($assignedPeople??'', ENT_QUOTES, 'UTF-8', false); ?>/<?php echo \htmlentities($maxPeople ?: '∞'??'', ENT_QUOTES, 'UTF-8', false); ?>

 </span>
 </td>
 <td class="text-center">
 <span class="badge <?php echo \htmlentities($checkedIn === $totalGuests && $totalGuests > 0 ? 'bg-success' : 'bg-warning text-dark'??'', ENT_QUOTES, 'UTF-8', false); ?> rounded-pill px-3 py-2">
 <i class="bi bi-check2-circle me-1"></i><?php echo \htmlentities($checkedIn??'', ENT_QUOTES, 'UTF-8', false); ?>/<?php echo \htmlentities($totalGuests??'', ENT_QUOTES, 'UTF-8', false); ?>

 </span>
 </td>
 <td>
 <div><?php echo \htmlentities($t['meeting_point'] ?: '— Chưa cập nhật —'??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php if(!empty($t['meeting_time'])): ?>
 <div class="text-muted small">Giờ: <?php echo \htmlentities(date('H:i', strtotime($t['meeting_time']))??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php endif; ?>
 </td>
 <td>
 <div>Đi: <?php echo \htmlentities(!empty($t['departure_date']) ? date('d/m/Y', strtotime($t['departure_date'])) : '—'??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <div class="text-muted small">Về: <?php echo \htmlentities(!empty($t['return_date']) ? date('d/m/Y', strtotime($t['return_date'])) : '—'??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 </td>
 <td>
 <span class="badge <?php echo \htmlentities($statusInfo[1]??'', ENT_QUOTES, 'UTF-8', false); ?> rounded-pill px-3 py-2"><?php echo \htmlentities($statusInfo[0]??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 </td>
 <td class="text-center">
 <a href="<?php echo \htmlentities(route('hdv/tour-phan-cong?departure_id=' . $t['departure_id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-primary rounded-3 px-3 fw-bold me-1" title="Xem danh sách khách & check-in">
 <i class="bi bi-people-fill me-1"></i> Xem đoàn
 </a>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php endif; ?>
 </tbody>
 </table>
 </div>
</div>

<!-- Detailed Customer List Section for Selected Tour -->
<?php if($selectedTour): ?>
 <?php 
 $checkedInTotal = (int)($selectedTour['checked_in_guests'] ?? 0);
 $guestsTotal = (int)($selectedTour['total_guests'] ?? 0);
 $statusMap = [
 'scheduled' => ['Chờ khởi hành', 'bg-warning text-dark'],
 'in_progress' => ['Đang diễn ra', 'bg-primary'],
 'completed' => ['Hoàn tất', 'bg-success'],
 'cancelled' => ['Đã hủy', 'bg-secondary'],
 ];
 $statusInfo = $statusMap[$selectedTour['departure_status']] ?? [$selectedTour['departure_status'], 'bg-secondary'];
 $groupName = $selectedTour['group_name'] ?: ('Đoàn ' . ($selectedTour['tour_name'] ?? 'Tour #' . $selectedTour['tour_id']));
 ?>
 <div class="hdv-card border-primary">
 <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
 <div>
 <h5 class="fw-bold text-primary mb-1">
 <i class="bi bi-people-fill me-2"></i> Danh sách khách check-in: <?php echo \htmlentities($groupName??'', ENT_QUOTES, 'UTF-8', false); ?> (#<?php echo \htmlentities($selectedTour['departure_id']??'', ENT_QUOTES, 'UTF-8', false); ?>)
 </h5>
 <p class="text-muted small mb-1">
 Tour: <strong class="text-dark"><?php echo \htmlentities($selectedTour['tour_name']??'', ENT_QUOTES, 'UTF-8', false); ?></strong>
 · Điểm tập kết: <?php echo \htmlentities($selectedTour['meeting_point'] ?: 'Chưa cập nhật'??'', ENT_QUOTES, 'UTF-8', false); ?>

 · Ngày đi: <?php echo \htmlentities(!empty($selectedTour['departure_date']) ? date('d/m/Y', strtotime($selectedTour['departure_date'])) : '—'??'', ENT_QUOTES, 'UTF-8', false); ?>

 </p>
 <p class="mb-0 small">
 <span class="me-3"><i class="bi bi-info-circle me-1"></i>Trạng thái: <span class="badge <?php echo \htmlentities($statusInfo[1]??'', ENT_QUOTES, 'UTF-8', false); ?>"><?php echo \htmlentities($statusInfo[0]??'', ENT_QUOTES, 'UTF-8', false); ?></span></span>
 <span class="me-3"><i class="bi bi-receipt me-1"></i><?php echo \htmlentities((int)($selectedTour['total_bookings'] ?? 0)??'', ENT_QUOTES, 'UTF-8', false); ?> booking</span>
 <span class="me-3"><i class="bi bi-people me-1"></i>Số khách: <strong><?php echo \htmlentities((int)($selectedTour['assigned_people'] ?? 0)??'', ENT_QUOTES, 'UTF-8', false); ?>/<?php echo \htmlentities((int)($selectedTour['max_participants'] ?? 0)??'', ENT_QUOTES, 'UTF-8', false); ?></strong></span>
 <span><i class="bi bi-check2-circle me-1"></i>Check-in: <strong class="<?php echo \htmlentities($checkedInTotal === $guestsTotal && $guestsTotal > 0 ? 'text-success' : 'text-warning'??'', ENT_QUOTES, 'UTF-8', false); ?>"><?php echo \htmlentities($checkedInTotal??'', ENT_QUOTES, 'UTF-8', false); ?>/<?php echo \htmlentities($guestsTotal??'', ENT_QUOTES, 'UTF-8', false); ?></strong></span>
 </p>
 </div>
 <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill"><?php echo \htmlentities(count($guests)??'', ENT_QUOTES, 'UTF-8', false); ?> khách</span>
 </div>

 <div class="table-responsive">
 <table class="table table-bordered table-hover align-middle">
 <thead class="table-light">
 <tr>
 <th style="width: 50px;">STT</th>
 <th>Họ và Tên Khách Hàng</th>
 <th>Giới tính</th>
 <th>Liên hệ</th>
 <th>CMND/CCCD</th>
 <th class="text-center">Trạng thái Check-in</th>
 <th>Ghi chú / Yêu cầu đặc biệt</th>
 </tr>
 </thead>
 <tbody>
 <?php if(empty($guests)): ?>
 <tr>
 <td colspan="7" class="text-center py-4 text-muted">
 Đoàn này chưa có dữ liệu danh sách khách hàng trong bảng <code>booking_guests</code>. Vui lòng liên hệ quản trị viên để thêm khách vào đoàn.
 </td>
 </tr>
 <?php else: ?>
 <?php $__currentLoopData = $guests; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $idx => $g): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td class="fw-bold text-center"><?php echo \htmlentities($idx + 1??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <div class="fw-bold text-dark"><?php echo \htmlentities($g['full_name']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php if(!empty($g['dob'])): ?>
 <div class="text-muted small">Ngày sinh: <?php echo \htmlentities(date('d/m/Y', strtotime($g['dob']))??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php endif; ?>
 <?php if(!empty($g['booking_id'])): ?>
 <div class="text-muted small mt-1">Booking #<?php echo \htmlentities((int)$g['booking_id']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php endif; ?>
 </td>
 <td>
 <?php if($g['gender'] === 'male'): ?>
 <span class="badge bg-info-subtle text-dark"><i class="bi bi-gender-male me-1"></i> Nam</span>
 <?php elseif($g['gender'] === 'female'): ?>
 <span class="badge bg-danger-subtle text-dark"><i class="bi bi-gender-female me-1"></i> Nữ</span>
 <?php else: ?>
 <span class="text-muted">Khác</span>
 <?php endif; ?>
 </td>
 <td>
 <div><i class="bi bi-telephone text-primary me-1"></i> <?php echo \htmlentities($g['phone'] ?: 'N/A'??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php if(!empty($g['email'])): ?>
 <div class="text-muted small"><i class="bi bi-envelope me-1"></i> <?php echo \htmlentities($g['email']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php endif; ?>
 </td>
 <td><?php echo \htmlentities($g['identity_no'] ?: '—'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td class="text-center">
 <form method="POST" action="<?php echo \htmlentities(route('hdv/guest/check-in')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="d-inline">
 <input type="hidden" name="guest_id" value="<?php echo \htmlentities($g['id']??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <input type="hidden" name="departure_id" value="<?php echo \htmlentities($selectedDepartureId??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php if($g['check_in_status'] == 1): ?>
 <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 fw-bold" title="Nhấn để đổi trạng thái">
 <i class="bi bi-check-circle-fill me-1"></i> Đã Check-in
 </button>
 <?php if(!empty($g['checked_in_at'])): ?>
 <div class="text-muted small mt-1">Lúc: <?php echo \htmlentities(date('H:i d/m', strtotime($g['checked_in_at']))??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php endif; ?>
 <?php else: ?>
 <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="Nhấn để check-in">
 <i class="bi bi-circle me-1"></i> Chưa Check-in
 </button>
 <?php endif; ?>
 </form>
 </td>
 <td>
 <?php if(!empty($g['note'])): ?>
 <span class="badge bg-warning text-dark"><?php echo \htmlentities($g['note']??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 <?php else: ?>
 <span class="text-muted">—</span>
 <?php endif; ?>
 <?php if(!empty($g['payment_status']) && $g['payment_status'] !== 'unpaid'): ?>
 <div class="mt-1">
 <?php if($g['payment_status'] === 'paid'): ?>
 <span class="badge bg-success text-white"><i class="bi bi-cash-stack me-1"></i>Đã TT</span>
 <?php elseif($g['payment_status'] === 'deposit'): ?>
 <span class="badge bg-info text-white"><i class="bi bi-wallet2 me-1"></i>Đã cọc</span>
 <?php endif; ?>
 </div>
 <?php endif; ?>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php endif; ?>
 </tbody>
 </table>
 </div>
 </div>
<?php endif; ?>

