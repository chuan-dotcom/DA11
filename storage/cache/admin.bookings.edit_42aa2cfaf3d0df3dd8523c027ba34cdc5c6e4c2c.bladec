 ?>
 <option value="<?php echo \htmlentities($tour['id']??'', ENT_QUOTES, 'UTF-8', false); ?>" <?php echo \htmlentities($selected??'', ENT_QUOTES, 'UTF-8', false); ?>><?php echo \htmlentities($tour['name']??'', ENT_QUOTES, 'UTF-8', false); ?></option>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
