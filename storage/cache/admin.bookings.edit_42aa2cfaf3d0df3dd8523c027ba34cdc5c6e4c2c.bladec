 <div class="mb-3 mt-3">
 <label class="form-label">Ngày khởi hành</label>
 <input type="date" name="booking_date" id="booking_date" class="form-control" required value="<?php echo \htmlentities(isset($_POST['booking_date']) ? htmlentities($_POST['booking_date']) : $booking['booking_date']??'', ENT_QUOTES, 'UTF-8', false); ?>">
 </div>

 <div class="mb-3">
 <label class="form-label">Trạng thái</label>
 <select name="status" class="form-select">
 <?php $s = isset($_POST['status']) ? (int)$_POST['status'] : (int)$booking['status'];  ?>
 <option value="0" <?php echo \htmlentities($s === 0 ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Chờ xác nhận</option>
 <option value="1" <?php echo \htmlentities($s === 1 ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Đã xác nhận</option>
 <option value="2" <?php echo \htmlentities($s === 2 ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Đã hủy</option>
 </select>
