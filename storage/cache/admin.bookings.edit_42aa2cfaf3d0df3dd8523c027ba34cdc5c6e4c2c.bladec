 <input type="number" name="num_people" class="form-control" min="1" required value="<?php echo \htmlentities(isset($_POST['num_people']) ? (int)$_POST['num_people'] : $booking['num_people']??'', ENT_QUOTES, 'UTF-8', false); ?>">
 </div>
 </div>
 <div class="col-md-6">
 <div class="mb-0">
 <label class="form-label">Tổng tiền hiện tại</label>
 <input type="text" class="form-control" disabled value="<?php echo \htmlentities(number_format($booking['total_price'])??'', ENT_QUOTES, 'UTF-8', false); ?> VNĐ">
 </div>
