<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('title', $title); ?>

<?php $this->startSection('content'); ?>
<style>
 .user-avatar {
 width: 60px;
 height: 60px;
 object-fit: cover;
 border-radius: 50%;
 border: 2px solid #e5e7eb;
 }
 .user-avatar-sm {
 width: 40px;
 height: 40px;
 object-fit: cover;
 border-radius: 50%;
 border: 1px solid #e5e7eb;
 }
 .role-badge-admin {
 background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
 }
 .role-badge-user {
 background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
 }
</style>

<div class="container mt-4">
 <h2 class="mb-4">
 <i class="bi bi-people"></i> <?php echo \htmlentities($title??'', ENT_QUOTES, 'UTF-8', false); ?>

 </h2>

 <?php if(isset($_SESSION['success'])): ?>
 <div class="alert alert-success"><?php echo \htmlentities($_SESSION['success']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php unset($_SESSION['success']);  ?>
 <?php endif; ?>
 <?php if(isset($_SESSION['error'])): ?>
 <div class="alert alert-danger"><?php echo \htmlentities($_SESSION['error']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php unset($_SESSION['error']);  ?>
 <?php endif; ?>
 <?php if(isset($_SESSION['flash']['success'])): ?>
 <div class="alert alert-success"><?php echo \htmlentities($_SESSION['flash']['success']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php unset($_SESSION['flash']['success']);  ?>
 <?php endif; ?>
 <?php if(isset($_SESSION['flash']['error'])): ?>
 <div class="alert alert-danger"><?php echo \htmlentities($_SESSION['flash']['error']??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 <?php unset($_SESSION['flash']['error']);  ?>
 <?php endif; ?>

 <div class="mb-3">
 <a href="<?php echo \htmlentities(route('admin/users/create')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-primary">
 <i class="bi bi-person-plus"></i> Thêm mới tài khoản
 </a>
 </div>

 <div class="card shadow-sm">
 <div class="card-body">
 <div class="table-responsive">
 <table class="table table-bordered table-hover align-middle">
 <thead class="table-dark">
 <tr>
 <th width="60">ID</th>
 <th width="80">Ảnh đại diện</th>
 <th>Họ tên</th>
 <th>Email</th>
 <th>Số điện thoại</th>
 <th>Vai trò</th>
 <th>Trạng thái</th>
 <th width="220">Thao tác</th>
 </tr>
 </thead>
 <tbody>
 <?php if(empty($users)): ?>
 <tr>
 <td colspan="8" class="text-center py-4 text-muted">
 <i class="bi bi-inbox fs-2 d-block mb-2"></i>
 Chưa có tài khoản nào
 </td>
 </tr>
 <?php else: ?>
 <?php $__currentLoopData = $users; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $user): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td class="fw-semibold text-center"><?php echo \htmlentities($user['id']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td class="text-center">
 <?php if($user['avatar']): ?>
 <img src="<?php echo \htmlentities(file_url($user['avatar'])??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="<?php echo \htmlentities($user['name']??'', ENT_QUOTES, 'UTF-8', false); ?>" class="user-avatar-sm">
 <?php else: ?>
 <div class="d-flex align-items-center justify-content-center user-avatar-sm bg-light text-muted">
 <i class="bi bi-person fs-5"></i>
 </div>
 <?php endif; ?>
 </td>
 <td>
 <a href="<?php echo \htmlentities(route('admin/users/show/' . $user['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="text-decoration-none fw-semibold text-dark">
 <?php echo \htmlentities($user['name']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </a>
 </td>
 <td class="text-muted"><?php echo \htmlentities($user['email']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($user['phone'] ?: '<span class="text-muted">—</span>'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <?php if($user['role'] == 'admin'): ?>
 <span class="badge role-badge-admin px-3 py-2">
 <i class="bi bi-shield-check me-1"></i>Admin
 </span>
 <?php else: ?>
 <span class="badge role-badge-user px-3 py-2">
 <i class="bi bi-person me-1"></i>User
 </span>
 <?php endif; ?>
 </td>
 <td>
 <?php if($user['status'] == 1): ?>
 <span class="badge bg-success px-3 py-2">
 <i class="bi bi-check-circle me-1"></i>Hoạt động
 </span>
 <?php else: ?>
 <span class="badge bg-secondary px-3 py-2">
 <i class="bi bi-x-circle me-1"></i>Khóa
 </span>
 <?php endif; ?>
 </td>
 <td class="text-nowrap">
 <a href="<?php echo \htmlentities(route('admin/users/show/' . $user['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-info text-white" title="Xem chi tiết">
 <i class="bi bi-eye"></i> Xem
 </a>
 <a href="<?php echo \htmlentities(route('admin/users/edit/' . $user['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-warning" title="Sửa">
 <i class="bi bi-pencil"></i> Sửa
 </a>
 <a href="<?php echo \htmlentities(route('admin/users/delete/' . $user['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>"
 class="btn btn-sm btn-danger"
 title="Xóa"
 onclick="return confirm('Bạn có chắc muốn xóa tài khoản này? Hành động này không thể hoàn tác!')">
 <i class="bi bi-trash"></i> Xóa
 </a>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php endif; ?>
 </tbody>
 </table>
 </div>
 </div>
 <div class="card-footer bg-light py-2">
 <small class="text-muted">
 <i class="bi bi-info-circle me-1"></i>
 Tổng số tài khoản: <strong><?php echo \htmlentities(count($users)??'', ENT_QUOTES, 'UTF-8', false); ?></strong>
 </small>
 </div>
 </div>
</div>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layouts.admin'); } ?>