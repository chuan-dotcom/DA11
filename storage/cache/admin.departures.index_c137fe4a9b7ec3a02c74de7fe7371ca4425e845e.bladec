 <div class="mb-3 d-flex gap-2 flex-wrap align-items-end">
 <a href="<?php echo \htmlentities(route('admin/departures/create')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-primary">
 <i class="bi bi-plus"></i> Thêm chuyến khởi hành
 </a>
 <a href="<?php echo \htmlentities(route('admin/staff-assignments')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-outline-info">
 <i class="bi bi-people"></i> Quản lý phân bổ
 </a>
 <form method="get" class="d-flex gap-2 flex-wrap align-items-end ms-auto">
 <div>
 <label for="category_id" class="form-label small mb-1">Danh mục tour</label>
 <select name="category_id" id="category_id" class="form-select form-select-sm">
 <option value="">Tất cả</option>
 <?php $__currentLoopData = $categories; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $category): $loop = $this->incrementLoopIndices();  ?>
 <option value="<?php echo \htmlentities($category['id']??'', ENT_QUOTES, 'UTF-8', false); ?>" <?php echo \htmlentities((!empty($categoryId) && (int) $categoryId === (int) $category['id']) ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>
 <?php echo \htmlentities($category['name']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </option>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </select>
 </div>
 <button type="submit" class="btn btn-outline-primary btn-sm">Lọc</button>
 <?php if(!empty($categoryId)): ?>
 <a href="<?php echo \htmlentities(route('admin/departures')??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-outline-secondary btn-sm">Xóa lọc</a>
 <?php endif; ?>
 </form>
 </div>

 <?php if(!empty($categoryId)): ?>
 <?php 
 $selectedCategoryName = 'Đã chọn';
 foreach ($categories as $category) {
 if ((int) $category['id'] === (int) $categoryId) {
 $selectedCategoryName = $category['name'];
 break;
 }
 }
 ?>
 <div class="alert alert-info py-2 mb-3">
 Đang xem chuyến khởi hành thuộc danh mục: <strong><?php echo \htmlentities($selectedCategoryName??'', ENT_QUOTES, 'UTF-8', false); ?></strong>
 </div>
 <?php endif; ?>

 <div class="card">
 <div class="card-body">
 <div class="table-responsive">
 <table class="table table-bordered table-hover align-middle">
