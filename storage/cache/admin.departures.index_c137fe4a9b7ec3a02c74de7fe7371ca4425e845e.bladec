 </tr>
 <?php else: ?>
 <?php $__currentLoopData = $departures; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $d): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td><?php echo \htmlentities($d['id']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <a href="<?php echo \htmlentities(route('admin/departures/show/' . $d['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="fw-semibold text-decoration-none text-dark">
 <?php echo \htmlentities($d['tour_name'] ?? 'N/A'??'', ENT_QUOTES, 'UTF-8', false); ?>

 </a>
 </td>
 <td><?php echo \htmlentities(date('d/m/Y', strtotime($d['departure_date']))??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($d['return_date'] ? date('d/m/Y', strtotime($d['return_date'])) : '-'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($d['meeting_point'] ?? '-'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($d['vehicle'] ?? '-'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td class="text-center"><?php echo \htmlentities($d['max_participants']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <?php 
 $statusText = [
 'scheduled' => 'Lên lịch',
 'in_progress' => 'Đang diễn ra',
 'completed' => 'Hoàn thành',
 'cancelled' => 'Đã hủy'
 ];
 ?>
 <span class="badge status-<?php echo \htmlentities($d['status']??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php echo \htmlentities($statusText[$d['status']] ?? $d['status']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </span>
 </td>
 <td class="text-nowrap">
 <a href="<?php echo \htmlentities(route('admin/departures/show/' . $d['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-info text-white">
 <i class="bi bi-eye"></i>
 </a>
 <a href="<?php echo \htmlentities(route('admin/departures/edit/' . $d['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-warning">
 <i class="bi bi-pencil"></i>
 </a>
 <a href="<?php echo \htmlentities(route('admin/guest-groups/show/' . $d['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-primary">
 <i class="bi bi-people"></i>
 </a>
 <a href="<?php echo \htmlentities(route('admin/staff-assignments/create')??'', ENT_QUOTES, 'UTF-8', false); ?>?departure_id=<?php echo \htmlentities($d['id']??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-success">
 <i class="bi bi-person-plus"></i>
 </a>
 <a href="<?php echo \htmlentities(route('admin/departures/delete/' . $d['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>"
 class="btn btn-sm btn-danger"
 onclick="return confirm('Bạn có chắc muốn xóa chuyến khởi hành này?')">
 <i class="bi bi-trash"></i>
 </a>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 <?php endif; ?>
 </tbody>
 </table>
 </div>
