 <div class="text-muted small">Lên lịch</div>
 <div class="fs-4 fw-bold text-primary"><?php echo \htmlentities($statusMap['scheduled'] ?? 0??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 </div>
 <i class="bi bi-clock fs-2 text-primary"></i>
 </div>
 </div>
 </div>
 </div>
