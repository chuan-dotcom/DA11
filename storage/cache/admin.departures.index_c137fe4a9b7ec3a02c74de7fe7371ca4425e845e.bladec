 <?php endif; ?>

 <div class="row mb-4 g-3">
 <?php 
 $statusMap = [];
 foreach($statusCounts as $sc) { $statusMap[$sc['status']] = $sc['count']; }
 ?>
 <div class="col-md-3">
 <div class="card stat-card">
 <div class="card-body">
 <div class="d-flex justify-content-between align-items-center">
