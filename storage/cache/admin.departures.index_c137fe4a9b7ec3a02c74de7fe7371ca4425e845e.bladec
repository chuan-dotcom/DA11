 <div class="fs-4 fw-bold"><?php echo \htmlentities(count($departures)??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 </div>
 <i class="bi bi-calendar3 fs-2 text-primary"></i>
 </div>
 </div>
 </div>
