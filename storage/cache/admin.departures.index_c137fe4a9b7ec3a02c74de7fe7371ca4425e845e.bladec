 <div class="fs-4 fw-bold text-warning"><?php echo \htmlentities($statusMap['in_progress'] ?? 0??'', ENT_QUOTES, 'UTF-8', false); ?></div>
 </div>
 <i class="bi bi-play-circle fs-2 text-warning"></i>
 </div>
 </div>
 </div>
