 <tbody>
 <?php if(empty($tours)): ?>
 <tr>
 <td colspan="8" class="text-center">Chưa có tour nào</td>
 </tr>
 <?php else: ?>
 <?php $__currentLoopData = $tours; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $tour): $loop = $this->incrementLoopIndices();  ?>
 <?php $detailUrl = absolute_url('tour/' . $tour['id']);  ?>
 <tr>
 <td><?php echo \htmlentities($tour['id']??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <a href="<?php echo \htmlentities(route('admin/tours/show/' . $tour['id'])??'', ENT_QUOTES, 'UTF-8', false); ?>" title="Xem chi tiết">
 <?php if($tour['image']): ?>
 <img src="<?php echo \htmlentities(file_url($tour['image'])??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="<?php echo \htmlentities($tour['name']??'', ENT_QUOTES, 'UTF-8', false); ?>" class="tour-thumb">
 <?php else: ?>
 <span class="text-muted">Không có ảnh</span>
 <?php endif; ?>
 </a>
 </td>
