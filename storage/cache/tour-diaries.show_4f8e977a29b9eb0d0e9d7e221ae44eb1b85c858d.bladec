 <span class="diary-meta-chip"><i class="bi bi-people"></i> <?php echo \htmlentities($diary['departure_group_name'] ?? 'Đoàn #' . $diary['departure_id']??'', ENT_QUOTES, 'UTF-8', false); ?></span>
